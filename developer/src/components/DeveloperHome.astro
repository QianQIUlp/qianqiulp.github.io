---
import BaseLayout from '../layouts/BaseLayout.astro';
import { meta, links, type Locale } from '../content';
import englishHome from '../fragments/home-en.html?raw';
import chineseHome from '../fragments/home-zh.html?raw';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = meta[locale];
const studioJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Q Studio',
  url: 'https://qiu.works',
  email: 'qstudio@qiu.works',
  description: content.description,
  founder: { '@type': 'Person', name: 'Qian Qiu' },
  sameAs: [links.github, links.verisilo],
};
---

<BaseLayout
  locale={locale}
  title={content.title}
  description={content.description}
  image={content.image}
  imageAlt={content.imageAlt}
>
  <Fragment set:html={locale === 'zh' ? chineseHome : englishHome} />
  <script type="application/ld+json" set:html={JSON.stringify(studioJsonLd)} />

  <script is:inline>
    const windowEl = document.getElementById('specimen-window');
    const seam = document.getElementById('seam-range');
    const seamHandle = document.getElementById('specimen-seam');
    const dialog = document.getElementById('image-dialog');
    const dialogImage = document.getElementById('dialog-image');
    const locale = document.documentElement.lang.startsWith('zh') ? 'zh' : 'en';

    const updateSeam = () => {
      windowEl.style.setProperty('--cut', `${seam.value}%`);
      seam.setAttribute('aria-valuetext', locale === 'zh' ? `镜片位于画面左侧 ${seam.value}% 处` : `Lens at ${seam.value}% from the left`);
      const width = windowEl.getBoundingClientRect().width;
      const radius = seamHandle.getBoundingClientRect().width / 2;
      const progress = (Number(seam.value) - Number(seam.min)) / (Number(seam.max) - Number(seam.min));
      windowEl.style.setProperty('--proof-offset', `${-2 * radius * 1.8125 * progress}px`);
      const tailReach = parseFloat(getComputedStyle(seamHandle, '::before').width) * .4;
      windowEl.dataset.tail = width * Number(seam.value) / 100 + radius + tailReach > width ? 'left' : 'right';
    };
    const constrainSeam = () => {
      const width = windowEl.getBoundingClientRect().width;
      const radius = seamHandle.getBoundingClientRect().width / 2;
      const margin = 8;
      seam.min = Math.ceil((radius + margin) / width * 100);
      seam.max = Math.floor((width - radius - margin) / width * 100);
      seam.value = Math.max(Number(seam.min), Math.min(Number(seam.max), Number(seam.value)));
      updateSeam();
    };
    const moveSeam = event => {
      const bounds = windowEl.getBoundingClientRect();
      const value = Math.round((event.clientX - bounds.left) / bounds.width * 100);
      seam.value = Math.max(Number(seam.min), Math.min(Number(seam.max), value));
      seam.dispatchEvent(new Event('input', { bubbles: true }));
    };
    seam.addEventListener('input', updateSeam);
    window.addEventListener('resize', constrainSeam);
    seamHandle.addEventListener('pointerdown', event => {
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      event.preventDefault();
      seamHandle.setPointerCapture(event.pointerId);
      moveSeam(event);
    });
    seamHandle.addEventListener('pointermove', event => {
      if (seamHandle.hasPointerCapture(event.pointerId)) moveSeam(event);
    });
    constrainSeam();

    let opener;
    document.querySelectorAll('.capture-button').forEach(link => link.addEventListener('click', event => {
      if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || !dialog.showModal) return;
      event.preventDefault();
      opener = link;
      const image = link.querySelector('img');
      dialogImage.src = image.src;
      dialogImage.alt = image.alt;
      document.getElementById('dialog-title').textContent = image.dataset.image.toUpperCase() + (locale === 'zh' ? ' / 真实画面' : ' / REAL CAPTURE');
      dialog.showModal();
    }));
    document.getElementById('dialog-close').addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => opener?.focus({ preventScroll: true }));

    const language = document.getElementById('language');
    const languagePath = language.getAttribute('href');
    language.addEventListener('click', () => { language.href = languagePath + location.hash; });
  </script>
</BaseLayout>
