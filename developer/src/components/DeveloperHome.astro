---
import BaseLayout from '../layouts/BaseLayout.astro';
import { copy, links, type Locale } from '../content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = copy[locale];
const homeHref = locale === 'en' ? '/' : '/zh/';
const languageHref = locale === 'en' ? '/zh/' : '/';
const personalHref = locale === 'en' ? links.personalEn : links.personalZh;
const emailHref = 'mailto:qstudio@qiu.works';
const siteUrl = 'https://qiu.works';
const studioJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Q Studio',
  url: siteUrl,
  email: 'qstudio@qiu.works',
  description: content.meta.description,
  founder: { '@type': 'Person', name: 'Qian Qiu' },
  sameAs: [links.github, links.verisilo],
};
---

<BaseLayout
  locale={locale}
  title={content.meta.title}
  description={content.meta.description}
  image={content.meta.image}
  imageAlt={content.meta.imageAlt}
>
  <a class="skip-link" href="#main-content">{content.skip}</a>

  <header class="site-header">
    <div class="site-header__inner">
      <a class="wordmark" href={homeHref} aria-label={content.brandAria}>Q Studio<span>.</span></a>
      <nav class="site-nav" aria-label={content.navAria}>
        <a href="#work" data-spy="work">{content.nav.work}</a>
        <a href="#studio" data-spy="studio">{content.nav.studio}</a>
        <a href="#approach" data-spy="approach">{content.nav.approach}</a>
        <a href="#writing" data-spy="writing">{content.nav.writing}</a>
        <a href="#contact" data-spy="contact">{content.nav.contact}</a>
      </nav>
      <div class="site-controls">
        <a
          class="language-toggle"
          href={languageHref}
          hreflang={locale === 'en' ? 'zh-CN' : 'en'}
          aria-label={content.languageAria}
        >{content.languageLabel}</a>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label={content.themeAria}>
          {content.night}
        </button>
      </div>
    </div>
  </header>

  <main id="main-content">
    <section class="hero section-shell" aria-labelledby="hero-title">
      <div class="hero__masthead">
        <p class="eyebrow">{content.hero.eyebrow}</p>
        <h1 id="hero-title">{content.hero.studio}<span aria-hidden="true">.</span></h1>
        <p class="hero__founder">{content.hero.studioLead}</p>
      </div>
      <div class="hero__copy">
        <p class="hero__statement">{content.hero.headline}</p>
        <p class="hero__body">{content.hero.body}</p>
        <div class="hero__actions">
          <a class="button button--primary" href="#work">{content.hero.workAction}</a>
          <a class="button button--quiet" href={links.github} target="_blank" rel="noopener noreferrer">{content.hero.githubAction}</a>
          <a class="text-link" href={personalHref}>{content.hero.personalAction}</a>
        </div>
      </div>

      <aside class="current-work" aria-label={content.hero.nowLabel}>
        <p class="current-work__label">
          <span>{content.hero.nowLabel}</span>
          <span class="current-work__serial" aria-hidden="true">FILE&nbsp;01</span>
        </p>
        <div class="current-work__heading">
          <a href={links.verisilo}>
            <i class="current-work__dot" aria-hidden="true"></i>
            {content.hero.nowProject}
          </a>
          <span>{content.hero.nowStatus}</span>
        </div>
        <a class="current-work__preview evidence-trigger" href={content.work.image} aria-label={`${content.interaction.inspect} — VeriSilo`} data-evidence>
          <img src={content.work.image} width="1440" height={content.work.imageHeight} alt={content.work.imageAlt} fetchpriority="high" />
          <span>{content.interaction.inspect}<span aria-hidden="true">↗</span></span>
        </a>
        <p>{content.hero.nowBody}</p>
      </aside>
      <nav class="hero__index" aria-label={content.interaction.projectIndex}>
        <a href="#work"><span>01</span> VeriSilo <i aria-hidden="true">↗</i></a>
        {content.projects.map((project, index) => (
          <a href={`#project-${project.key}`}><span>{String(index + 2).padStart(2, '0')}</span> {project.name} <i aria-hidden="true">↗</i></a>
        ))}
      </nav>
    </section>

    <section class="work section-shell" aria-labelledby="work-title">
      <header class="section-heading" id="work" data-reveal>
        <p class="eyebrow">{content.work.eyebrow}</p>
        <div>
          <h2 id="work-title">{content.work.title}</h2>
          <p>{content.work.lead}</p>
        </div>
      </header>

      <article class="featured-project" data-reveal>
        <figure class="featured-project__visual">
          <a class="evidence-trigger" href={content.work.image} aria-label={`${content.interaction.inspect} — VeriSilo`} data-evidence>
            <img
              src={content.work.image}
              width="1440"
              height={content.work.imageHeight}
              loading="lazy"
              alt={content.work.imageAlt}
            />
            <span>{content.interaction.inspect}<span aria-hidden="true">↗</span></span>
          </a>
          <figcaption>{content.interaction.evidenceCaption}</figcaption>
        </figure>
        <div class="featured-project__copy">
          <p class="project-index">{content.work.featuredLabel}</p>
          <p class="featured-project__tier">{content.work.featuredTier}</p>
          <p class="featured-project__audience">{content.work.featuredAudience}</p>
          <h3>{content.work.featuredTitle}</h3>
          <p>{content.work.featuredBody}</p>
          <p>{content.hero.nowEvidence}</p>
          <p class="boundary-note">{content.work.featuredBoundary}</p>
          <div class="project-links">
            <a href={links.verisilo}>{content.work.featuredProduct}</a>
            <a href={links.verisiloRepo} target="_blank" rel="noopener noreferrer">{content.work.featuredSource}</a>
          </div>
        </div>
      </article>

      <ol class="project-list" aria-label={content.work.listAria}>
        {content.projects.map((project, index) => (
          <li data-reveal style={`--reveal-order:${index};`}>
            <details class="project-dossier" id={`project-${project.key}`} name="projects">
              <summary>
                <span class="project-row__number" aria-hidden="true">{String(index + 2).padStart(2, '0')}</span>
                <span class="project-row__identity">
                  <span class="project-row__tier">{project.tier}</span>
                  <span class="project-name">{project.name}</span>
                  <span class="project-row__meta">{project.type}</span>
                </span>
                <span class="project-summary">{project.summary}</span>
                <span class="dossier-toggle"><span class="dossier-toggle__label">{content.interaction.details}</span><i aria-hidden="true"></i></span>
              </summary>
              <div class="project-dossier__body">
                <p class="project-status">{project.status}</p>
                <dl>
                  <div><dt>{content.interaction.audience}</dt><dd>{project.audience}</dd></div>
                  <div><dt>{content.interaction.decision}</dt><dd>{project.decision}</dd></div>
                </dl>
                <div class="project-links">
                  <a href={project.primaryHref} target="_blank" rel="noopener noreferrer">{project.primaryLabel}</a>
                  <a href={project.secondaryHref}>{project.secondaryLabel}</a>
                </div>
              </div>
            </details>
          </li>
        ))}
      </ol>
    </section>

    <section class="studio section-shell" aria-labelledby="studio-title">
      <header class="section-heading" id="studio" data-reveal>
        <p class="eyebrow">{content.studio.eyebrow}</p>
        <div>
          <h2 id="studio-title">{content.studio.title}</h2>
          <p>{content.studio.lead}</p>
        </div>
      </header>
      <div class="studio__body" data-reveal>
        <p>{content.studio.body}</p>
        <dl class="studio__facts" aria-label={content.studio.factsAria}>
          {content.studio.facts.map((fact, index) => (
            <div class:list={['studio__fact', { 'studio__fact--active': fact.href === links.verisilo }]}>
              <dt>
                <span class="studio__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                {fact.term}
              </dt>
              <dd>
                {fact.href ? <a href={fact.href}>{fact.linkLabel ?? fact.detail}</a> : fact.detail}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="approach section-shell" aria-labelledby="approach-title">
      <header class="section-heading" id="approach" data-reveal>
        <p class="eyebrow">{content.approach.eyebrow}</p>
        <div>
          <h2 id="approach-title">{content.approach.title}</h2>
          <p>{content.approach.lead}</p>
        </div>
      </header>
      <ol class="principle-list">
        {content.approach.principles.map((principle, index) => (
          <li data-reveal style={`--reveal-order:${index};`}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{principle.title}</h3>
            <p>{principle.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="writing section-shell" aria-labelledby="writing-title">
      <header class="section-heading" id="writing" data-reveal>
        <p class="eyebrow">{content.writing.eyebrow}</p>
        <div>
          <h2 id="writing-title">{content.writing.title}</h2>
          <p>{content.writing.lead}</p>
        </div>
      </header>
      <ol class="writing-list">
        {content.writing.items.map((item, index) => (
          <li data-reveal style={`--reveal-order:${index};`}>
            <a href={item.href}>
              <time datetime={item.date.replaceAll('/', '-')}>{item.date}</time>
              <span>
                <strong>{item.title}</strong>
                <small>{item.description}</small>
              </span>
              <em>{content.writing.action}</em>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="personal-portal section-shell" aria-labelledby="personal-title" data-reveal>
      <a class="personal-portal__visual" href={personalHref} aria-label={content.personal.action}>
        <img
          src={content.personal.image}
          width="1200"
          height="630"
          loading="lazy"
          alt={content.personal.imageAlt}
        />
      </a>
      <div class="personal-portal__copy">
        <p class="eyebrow">{content.personal.eyebrow}</p>
        <h2 id="personal-title">{content.personal.title}</h2>
        <p>{content.personal.body}</p>
        <a class="text-link" href={personalHref}>{content.personal.action}</a>
      </div>
    </section>

    <section class="contact section-shell" aria-labelledby="contact-title">
      <p class="eyebrow" id="contact" data-reveal>{content.contact.eyebrow}</p>
      <div class="contact__body" data-reveal>
        <div>
          <h2 id="contact-title">{content.contact.title}</h2>
          <p>{content.contact.body}</p>
        </div>
        <div class="contact__actions">
          <a class="contact-email" href={emailHref}>qstudio@qiu.works</a>
          <button class="copy-email" type="button" hidden>{content.interaction.copyEmail}<span aria-hidden="true">⧉</span></button>
          <span class="copy-status" role="status" aria-live="polite"></span>
          <a class="text-link" href={links.github} target="_blank" rel="noopener noreferrer">{content.contact.githubLabel}</a>
        </div>
      </div>
    </section>
  </main>

  <dialog class="evidence-dialog" aria-labelledby="evidence-title">
    <header>
      <div><p class="project-index">FILE 01 / VERISILO</p><h2 id="evidence-title">{content.interaction.evidenceTitle}</h2></div>
      <form method="dialog"><button class="dialog-close" aria-label={content.interaction.close}>×</button></form>
    </header>
    <div class="evidence-dialog__viewport" tabindex="0" role="region" aria-label={content.interaction.evidenceTitle}>
      <img src={content.work.image} width="1440" height={content.work.imageHeight} alt={content.work.imageAlt} loading="lazy" />
    </div>
    <footer>
      <p>{content.interaction.evidenceCaption}</p>
      <button class="evidence-zoom" type="button" aria-pressed="false">{content.interaction.actualSize}</button>
      <a class="text-link" href={links.verisilo}>{content.work.featuredProduct} ↗</a>
    </footer>
  </dialog>

  <footer class="site-footer">
    <div class="site-footer__inner">
      <p>{content.footer}</p>
      <nav aria-label={locale === 'en' ? 'Footer links' : '页脚链接'}>
        <a href={personalHref}>{content.hero.personalAction}</a>
        <a href={emailHref}>{content.nav.contact}</a>
        <a href={links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      </nav>
    </div>
  </footer>

  <script type="application/ld+json" set:html={JSON.stringify(studioJsonLd)} />

  <script is:inline define:vars={{ dayLabel: content.day, nightLabel: content.night, interaction: content.interaction }}>
    (function () {
      var html = document.documentElement;
      var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      /* Theme toggle: instant swap by default; when View Transitions are
         available and motion is allowed, reveal the new theme as a circle
         growing from the toggle, like a lamp being switched on the desk. */
      var button = document.getElementById('theme-toggle');
      if (button) {
        var render = function () {
          var dark = html.getAttribute('data-theme') === 'dark';
          button.textContent = dark ? dayLabel : nightLabel;
          button.setAttribute('aria-pressed', dark ? 'true' : 'false');
        };
        var applyTheme = function () {
          var dark = html.getAttribute('data-theme') !== 'dark';
          if (dark) {
            html.setAttribute('data-theme', 'dark');
            try { localStorage.setItem('theme', 'dark'); } catch (_) {}
          } else {
            html.removeAttribute('data-theme');
            try { localStorage.setItem('theme', 'light'); } catch (_) {}
          }
          render();
        };
        render();
        button.addEventListener('click', function () {
          var canTransition =
            typeof document.startViewTransition === 'function' && !reducedMotion.matches;
          if (!canTransition) {
            applyTheme();
            return;
          }
          var x = button.getBoundingClientRect().left + button.offsetWidth / 2;
          var y = button.getBoundingClientRect().top + button.offsetHeight / 2;
          html.style.setProperty('--theme-x', x + 'px');
          html.style.setProperty('--theme-y', y + 'px');
          document.startViewTransition(applyTheme);
        });
      }


      // Follow the actual reading position; retain explicit anchors across locales.
      var navLinks = Array.from(document.querySelectorAll('[data-spy]'));
      var sections = navLinks.map(function (link) { return document.getElementById(link.dataset.spy); });
      var languageLink = document.querySelector('.language-toggle');
      var languagePath = languageLink.getAttribute('href');
      var header = document.querySelector('.site-header');
      var frame = 0;
      var current;
      function updateNavigation() {
        frame = 0;
        var edge = Math.max(header.offsetHeight + 32, window.innerHeight * 0.28);
        var active = sections.filter(function (section) { return section.getBoundingClientRect().top <= edge; }).pop();
        var id = active ? active.id : '';
        if (id === current) return;
        current = id;
        navLinks.forEach(function (link) {
          var selected = link.dataset.spy === id;
          link.classList.toggle('is-active', selected);
          if (selected) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        });
      }
      function scheduleNavigation() {
        if (!frame) frame = requestAnimationFrame(updateNavigation);
      }
      window.addEventListener('scroll', scheduleNavigation, { passive: true });
      window.addEventListener('resize', scheduleNavigation);
      if ('ResizeObserver' in window) {
        new ResizeObserver(function () {
          html.style.setProperty('--anchor-offset', (header.offsetHeight + 24) + 'px');
          scheduleNavigation();
        }).observe(header);
      }
      document.querySelectorAll('.project-dossier').forEach(function (details) {
        details.addEventListener('toggle', scheduleNavigation);
      });
      function openLinkedProject() {
        var target = document.getElementById(window.location.hash.slice(1));
        languageLink.href = languagePath + (target && (sections.includes(target) || target.matches('.project-dossier')) ? '#' + target.id : '');
        if (target && target.matches('.project-dossier')) {
          target.open = true;
          target.scrollIntoView({ block: 'start' });
        }
        scheduleNavigation();
      }
      window.addEventListener('hashchange', openLinkedProject);
      document.querySelectorAll('.hero__index a[href^="#project-"]').forEach(function (link) {
        link.addEventListener('click', function () {
          document.getElementById(link.hash.slice(1)).open = true;
        });
      });
      openLinkedProject();

      // Image links remain usable without JavaScript. The modal adds a closer look.
      var dialog = document.querySelector('.evidence-dialog');
      var zoom = document.querySelector('.evidence-zoom');
      var opener;
      if (typeof dialog.showModal === 'function') {
        document.querySelectorAll('[data-evidence]').forEach(function (link) {
          link.setAttribute('aria-haspopup', 'dialog');
          link.addEventListener('click', function (event) {
            if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || event.button !== 0) return;
            event.preventDefault();
            opener = link;
            dialog.showModal();
            dialog.querySelector('.evidence-dialog__viewport').scrollTo(0, 0);
            html.classList.add('evidence-open');
          });
        });
        zoom.addEventListener('click', function () {
          var full = dialog.toggleAttribute('data-full-size');
          zoom.setAttribute('aria-pressed', String(full));
          zoom.textContent = full ? interaction.fitImage : interaction.actualSize;
        });
        dialog.addEventListener('close', function () {
          html.classList.remove('evidence-open');
          dialog.removeAttribute('data-full-size');
          zoom.setAttribute('aria-pressed', 'false');
          zoom.textContent = interaction.actualSize;
          if (opener) opener.focus({ preventScroll: true });
        });
      }

      var copyButton = document.querySelector('.copy-email');
      var copyStatus = document.querySelector('.copy-status');
      if (navigator.clipboard && window.isSecureContext) {
        copyButton.hidden = false;
        copyButton.addEventListener('click', async function () {
          copyStatus.textContent = '';
          try {
            await navigator.clipboard.writeText('qstudio@qiu.works');
            copyStatus.textContent = interaction.copied;
          } catch (_) {
            copyStatus.textContent = interaction.copyFailed;
          }
        });
      }
    })();
  </script>
</BaseLayout>
