---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import { siteCopy, type Lang } from '../i18n';

export interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  bodyClass?: string;
  lang?: Lang;
  themeColorLight?: string;
  themeColorDark?: string;
}

const {
  title,
  description,
  ogType = 'website',
  ogTitle = title,
  ogDescription = description,
  ogImage,
  lang = 'zh',
  ogImageAlt = siteCopy[lang].defaultImageAlt,
  bodyClass = '',
  themeColorLight = '#f1ebdb',
  themeColorDark = '#14171a',
} = Astro.props;
const copy = siteCopy[lang];
const resolvedOgImage = ogImage ?? (lang === 'en' ? '/assets/og/room-en.png' : '/assets/og/room-zh.png');
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const developerHref = lang === 'en' ? 'https://qiu.works/' : 'https://qiu.works/zh/';
const contactHref = `${developerHref}#contact`;
const developerLabel = lang === 'en' ? 'Developer profile' : '开发者主页';
const contactLabel = lang === 'en' ? 'Contact' : '联系我';
const alternatePath = lang === 'en'
  ? (Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/')
  : `/en${Astro.url.pathname}`;
---
<!doctype html>
<html lang={copy.htmlLang} class="no-js">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- FOUC 闪屏消除：必须在 <body> 渲染前同步执行 -->
  <script is:inline>
    (function(){
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
      if (new URLSearchParams(window.location.search).has('og')) {
        document.documentElement.classList.add('og-capture');
      }
      var t = localStorage.getItem('theme');
      if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();
  </script>
  <meta name="description" content={description} />
  <meta name="theme-color" content={themeColorLight} media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content={themeColorDark} media="(prefers-color-scheme: dark)" />
  <!-- 标题衬线：preconnect + 样式表直链，避免 CSS @import 链式阻塞 -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@600;700&family=Permanent+Marker&display=swap" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Qiu's Room" />
  <meta property="og:locale" content={copy.locale} />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={new URL(resolvedOgImage, Astro.site).href} />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="zh-CN" href={new URL(lang === 'zh' ? Astro.url.pathname : alternatePath, Astro.site).href} />
  <link rel="alternate" hreflang="en" href={new URL(lang === 'en' ? Astro.url.pathname : alternatePath, Astro.site).href} />
  <link rel="alternate" hreflang="x-default" href={new URL(lang === 'zh' ? Astro.url.pathname : alternatePath, Astro.site).href} />
  <slot name="extraHead" />
  <title>{title}</title>
  <slot name="extraCss" />
</head>
<body class:list={[bodyClass]}>
  <a class="skip-link" href="#main-content">{copy.skip}</a>

  <SiteHeader lang={lang} />

  <slot />

  <footer class="site-footer">
    <div class="site-footer__inner">
      <span class="site-footer__brand">
        <p>{copy.footer}</p>
      </span>
      <nav class="site-footer__links" aria-label={lang === 'en' ? 'Footer links' : '页脚链接'}>
        <a href={developerHref}>{developerLabel}</a>
        <a href={contactHref}>{contactLabel}</a>
        <a href="https://github.com/qianqiulp" target="_blank" rel="noopener noreferrer">GitHub</a>
      </nav>
    </div>
  </footer>

  <!-- 主题圆形转场覆盖层 -->
  <div class="theme-wipe" aria-hidden="true"><div class="theme-wipe__mist"></div></div>

  <!-- 深浅主题切换；减少动态偏好下即时切换 -->
  <script is:inline define:vars={{ dayLabel: copy.day, nightLabel: copy.night }}>
    (function(){
      var btn = document.getElementById('themeToggle');
      if (!btn) return;
      var html = document.documentElement;
      var wipe = document.querySelector('.theme-wipe');
      var mist = wipe && wipe.querySelector('.theme-wipe__mist');
      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      function render() {
        var isDark = html.getAttribute('data-theme') === 'dark';
        btn.textContent = isDark ? dayLabel : nightLabel;
        btn.setAttribute('aria-pressed', isDark ? 'true' : 'false');
      }

      function applyTheme(toDark) {
        if (toDark) {
          html.setAttribute('data-theme', 'dark');
          localStorage.setItem('theme', 'dark');
        } else {
          html.removeAttribute('data-theme');
          localStorage.setItem('theme', 'light');
        }
        render();
      }

      render();

      var activeAnims = null;
      var cleanupTimer = 0;

      function cleanupWipe() {
        window.clearTimeout(cleanupTimer);
        wipe.classList.remove('is-active');
        wipe.style.background = '';
        mist.style.background = '';
        activeAnims = null;
      }

      btn.addEventListener('click', function() {
        var toDark = html.getAttribute('data-theme') !== 'dark';
        var canAnimate = wipe && mist && !reduceMotion.matches && typeof wipe.animate === 'function';
        if (!canAnimate) {
          applyTheme(toDark);
          return;
        }

        if (activeAnims) {
          activeAnims.forEach(function(anim){ anim.cancel(); });
          cleanupWipe();
        }

        var rect = btn.getBoundingClientRect();
        var x = rect.left + rect.width / 2;
        var y = rect.top + rect.height / 2;
        var radius = Math.ceil(Math.hypot(
          Math.max(x, window.innerWidth - x),
          Math.max(y, window.innerHeight - y)
        ));

        // 先用旧底色盖住屏幕，再在遮盖下翻转主题，最后让旧色向点击处收拢，露出新主题
        var oldBg = getComputedStyle(html).getPropertyValue('--bg');
        wipe.style.background = oldBg;
        mist.style.background = oldBg;
        wipe.classList.add('is-active');

        applyTheme(toDark);

        var shrink = wipe.animate(
          [
            { clipPath: 'circle(' + radius + 'px at ' + x + 'px ' + y + 'px)' },
            { clipPath: 'circle(0px at ' + x + 'px ' + y + 'px)' }
          ],
          { duration: 720, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
        );
        var mistFade = mist.animate(
          [{ opacity: 0.85 }, { opacity: 0 }],
          { duration: 560, easing: 'ease-out' }
        );
        activeAnims = [shrink, mistFade];
        shrink.onfinish = cleanupWipe;
        cleanupTimer = window.setTimeout(cleanupWipe, 900);
      });
    })();
  </script>

  <!-- 渐进增强入场：无 JS 与减少动态偏好下内容始终可见 -->
  <script is:inline>
    (function(){
      var items = Array.prototype.slice.call(document.querySelectorAll('[data-reveal]'));
      if (!items.length) return;

      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduceMotion || !('IntersectionObserver' in window)) {
        items.forEach(function(item){ item.classList.add('is-visible'); });
        return;
      }

      var observer = new IntersectionObserver(function(entries){
        entries.forEach(function(entry){
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      }, {
        rootMargin: '0px 0px -8% 0px',
        threshold: 0.08,
      });

      items.forEach(function(item){ observer.observe(item); });
    })();
  </script>
</body>
</html>
