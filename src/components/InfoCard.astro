---
interface Props {
  title: string;
  description: string;
  color?: 'yellow' | 'green' | 'purple' | 'default';
}

const { title, description, color = 'default' } = Astro.props;
---

<div class:list={['card', color !== 'default' && `card-${color}`]}>
  <h2>{title}</h2>
  <p>{description}</p>
</div>

<style>
  .card {
    display: grid;
    gap: var(--space-2);
    min-height: 100%;
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s var(--ease-out), border-color 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
  }

  .card:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }

  .card h2 {
    margin: 0;
    color: var(--text);
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.35;
  }

  .card p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .card.card-yellow {
    background: var(--card-yellow-bg);
    border-color: var(--card-yellow-border);
    box-shadow: none;
  }
  .card.card-yellow h2,
  .card.card-yellow p {
    color: var(--card-yellow-text);
  }

  .card.card-green {
    background: var(--card-green-bg);
    border-color: var(--card-green-border);
    box-shadow: none;
  }
  .card.card-green h2,
  .card.card-green p {
    color: var(--card-green-text);
  }

  .card.card-purple {
    background: var(--card-purple-bg);
    border-color: var(--card-purple-border);
    box-shadow: none;
  }
  .card.card-purple h2,
  .card.card-purple p {
    color: var(--card-purple-text);
  }
</style>
