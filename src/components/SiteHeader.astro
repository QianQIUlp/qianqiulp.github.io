---
import { localizedPath, siteCopy, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
const copy = siteCopy[lang];
const currentPath = Astro.url.pathname;
const routePath = currentPath.replace(/^\/en(?=\/|$)/, '') || '/';
const navItems = [
  { href: localizedPath('/', lang), label: copy.nav.home, active: routePath === '/' },
  { href: localizedPath('/blog/', lang), label: copy.nav.blog, active: routePath === '/blog' || routePath === '/blog/' || routePath.startsWith('/blog/') },
  { href: localizedPath('/projects/', lang), label: copy.nav.projects, active: routePath === '/projects' || routePath === '/projects/' || routePath.startsWith('/projects/') },
];
const languageHref = localizedPath(routePath, lang === 'en' ? 'zh' : 'en');
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-brand" href={localizedPath('/', lang)} aria-label={copy.brandAria}>
      <span class="site-brand__text">
        <span class="site-brand__title">{copy.brand}</span>
        <span class="site-brand__subtitle">{copy.brandSubtitle}</span>
      </span>
    </a>

    <nav class="site-nav" aria-label={copy.navAria}>
      {navItems.map((item) => (
        <a
          class="site-nav__link"
          href={item.href}
          aria-current={item.active ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <a class="language-toggle" href={languageHref} hreflang={lang === 'en' ? 'zh-CN' : 'en'} aria-label={copy.languageAria}>
      {copy.languageLabel}
    </a>

    <button
      class="theme-toggle"
      id="themeToggle"
      type="button"
      aria-label={copy.themeAria}
      title={copy.themeAria}
    >
      {copy.night}
    </button>
  </div>
</header>
