---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      date: Date;
      tags: string[];
      description: string;
      ogImage?: ImageMetadata;
      ogImageAlt?: string;
    };
  };
  revealOrder?: number;
}

const { post, revealOrder = 0 } = Astro.props;
const formattedDate = post.data.date.toISOString().slice(0, 10);
const displayDate = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(post.data.date);
---

<a
  class="post-card"
  href={`/blog/posts/${post.id}/`}
  data-reveal
  style={`--reveal-order: ${revealOrder};`}
>
  <time class="post-card__date" datetime={formattedDate}>{displayDate}</time>
  <div class="post-card__cover">
    {post.data.ogImage ? (
      <Image src={post.data.ogImage} alt={post.data.ogImageAlt || `《${post.data.title}》文章封面`} loading="lazy" />
    ) : (
      <div class="post-card__fallback" aria-hidden="true">Qiu</div>
    )}
  </div>
  <div class="post-card__body">
    <h2>{post.data.title}</h2>
    <p class="post-card__description">{post.data.description}</p>
    <ul class="tag-list" aria-label="文章标签">
      {post.data.tags.map((tag) => (
        <li><span class="tag-pill">{tag}</span></li>
      ))}
    </ul>
  </div>
  <span class="post-card__cue" aria-hidden="true">阅读全文</span>
</a>

<style>
  .post-card {
    display: grid;
    grid-template-columns: minmax(88px, 0.18fr) minmax(128px, 180px) minmax(0, 1fr) auto;
    gap: clamp(14px, 2.5vw, 28px);
    align-items: center;
    min-height: 172px;
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    transition: background-color var(--motion-fast) var(--ease-out), border-color var(--motion-fast) var(--ease-out);
  }

  .post-card:hover {
    border-color: var(--border-strong);
    background: linear-gradient(90deg, color-mix(in srgb, var(--paper-raised) 82%, transparent), transparent);
    text-decoration: none;
  }

  .post-card__date {
    color: var(--warm);
    font-size: 0.86rem;
    font-weight: 800;
    line-height: 1.2;
    white-space: nowrap;
  }

  .post-card__cover {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface-muted);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--motion-fast) var(--ease-out);
  }

  .post-card:hover .post-card__cover {
    box-shadow: var(--shadow-note);
  }

  .post-card__body {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  .post-card h2 {
    margin: 0;
    color: var(--text);
    font-size: clamp(1.05rem, 2vw, 1.22rem);
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .post-card h2:hover {
    color: var(--accent-strong);
  }

  .post-card__description {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .post-card__fallback {
    display: grid;
    width: 100%;
    aspect-ratio: 4 / 3;
    place-items: center;
    background: var(--surface-muted);
    color: var(--text-muted);
    font-weight: 800;
  }

  .post-card__cue {
    align-self: center;
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 800;
    white-space: nowrap;
  }

  .post-card:hover .post-card__cue {
    color: var(--accent-strong);
  }

  @media (max-width: 760px) {
    .post-card {
      grid-template-columns: minmax(94px, 132px) minmax(0, 1fr);
      gap: var(--space-4);
      min-height: 0;
      padding: var(--space-4) 0;
    }

    .post-card__date {
      grid-column: 1 / -1;
    }

    .post-card__cue {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .post-card {
      grid-template-columns: 1fr;
    }

    .post-card__cover {
      max-width: 220px;
    }
  }

</style>

<style is:global>
  .post-card__cover img {
    width: 100% !important;
    height: 100% !important;
    aspect-ratio: 4 / 3 !important;
    object-fit: cover !important;
    display: block !important;
  }
</style>
