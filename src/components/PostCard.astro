---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      date: Date;
      tags: string[];
      description: string;
      ogImage?: ImageMetadata;
      ogImageAlt?: string;
    };
  };
}

const { post } = Astro.props;
const formattedDate = post.data.date.toISOString().slice(0, 10);
const displayDate = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(post.data.date);
---

<a class="post-card" href={`/blog/posts/${post.id}/`}>
  {post.data.ogImage && (
    <Image src={post.data.ogImage} alt={post.data.ogImageAlt || `《${post.data.title}》文章封面`} loading="lazy" />
  )}
  {!post.data.ogImage && <div class="post-card__fallback" aria-hidden="true">Qiu</div>}
  <div class="post-card__body">
    <p class="meta-line">
      <time datetime={formattedDate}>{displayDate}</time>
      <span>{post.data.tags.slice(0, 2).join(' / ')}</span>
    </p>
    <h2>{post.data.title}</h2>
    <p class="post-card__description">{post.data.description}</p>
    <ul class="tag-list" aria-label="文章标签">
      {post.data.tags.map((tag) => (
        <li><span class="tag-pill">{tag}</span></li>
      ))}
    </ul>
  </div>
</a>

<style>
  .post-card {
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 100%;
    overflow: hidden;
    border: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s var(--ease-out), border-color 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
  }

  .post-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
    text-decoration: none;
  }

  .post-card__body {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-5);
  }

  .post-card h2 {
    margin: 0;
    color: var(--text);
    font-size: clamp(1.05rem, 2vw, 1.22rem);
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .post-card__description {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .post-card__fallback {
    display: grid;
    width: 100%;
    aspect-ratio: 16 / 9;
    place-items: center;
    background: var(--surface-muted);
    color: var(--text-muted);
    font-weight: 800;
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card:hover {
      transform: none;
    }
  }
</style>

<style is:global>
  .post-card img {
    width: 100% !important;
    height: auto !important;
    aspect-ratio: 16 / 9 !important;
    object-fit: cover !important;
    display: block !important;
  }
</style>
