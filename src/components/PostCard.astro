---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      date: Date;
      tags: string[];
      description: string;
      ogImage?: ImageMetadata;
      ogImageAlt?: string;
    };
  };
}

const { post } = Astro.props;
const formattedDate = post.data.date.toISOString().slice(0, 10);
---

<a class="post-card" href={`/blog/posts/${post.id}/`}>
  {post.data.ogImage && (
    <Image
      src={post.data.ogImage}
      alt={post.data.ogImageAlt || `《${post.data.title}》文章封面`}
      loading="lazy"
    />
  )}
  <h3>{post.data.title}</h3>
  <p class="meta">
    <time datetime={formattedDate}>{formattedDate}</time>
    {post.data.tags.map((tag) => ` · ${tag}`)}
  </p>
</a>

<style>
  .post-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--surface-elevated);
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
  }

  .post-card:hover {
    transform: translateY(calc(var(--space-1) * -1));
    box-shadow: var(--shadow-lg);
  }

  .post-card h3 {
    margin: var(--space-4) var(--space-4) var(--space-2);
    font-size: 1.1rem;
  }

  .post-card .meta {
    margin: 0 var(--space-4) var(--space-4);
    font-size: 0.85rem;
    color: var(--text-secondary);
  }
</style>

<style is:global>
  .post-card img {
    width: 100% !important;
    height: auto !important;
    aspect-ratio: 16 / 9 !important;
    object-fit: cover !important;
    display: block !important;
  }
</style>
