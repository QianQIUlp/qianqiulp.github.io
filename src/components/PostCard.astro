---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { localizedPath, type Lang } from '../i18n';

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      date: Date;
      tags: string[];
      description: string;
      ogImage?: ImageMetadata;
      ogImageAlt?: string;
    };
  };
  revealOrder?: number;
  lang?: Lang;
}

const { post, revealOrder = 0, lang = 'zh' } = Astro.props;
const formattedDate = post.data.date.toISOString().slice(0, 10);
const displayDate = new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : 'zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(post.data.date);
---

<a
  class="post-card"
  href={localizedPath(`/blog/posts/${post.id}/`, lang)}
  data-reveal
  style={`--reveal-order: ${revealOrder};`}
>
  <time class="post-card__date" datetime={formattedDate}>{displayDate}</time>
  <div class="post-card__cover">
    {post.data.ogImage ? (
      <Image src={post.data.ogImage} alt={post.data.ogImageAlt || (lang === 'en' ? `Cover for ${post.data.title}` : `《${post.data.title}》文章封面`)} loading="lazy" />
    ) : (
      <div class="post-card__fallback" aria-hidden="true">{lang === 'en' ? 'Qianqiu' : '千秋'}</div>
    )}
  </div>
  <div class="post-card__body">
    <h2>{post.data.title}</h2>
    <p class="post-card__description">{post.data.description}</p>
    <ul class="tag-list" aria-label={lang === 'en' ? 'Article tags' : '文章标签'}>
      {post.data.tags.map((tag) => (
        <li><span class="tag-pill">{tag}</span></li>
      ))}
    </ul>
  </div>
  <span class="post-card__cue" aria-hidden="true">{lang === 'en' ? 'Read article' : '阅读全文'}</span>
</a>

<style>
  .post-card {
    display: grid;
    grid-template-columns: minmax(88px, 0.18fr) minmax(128px, 180px) minmax(0, 1fr) auto;
    gap: clamp(14px, 2.5vw, 28px);
    align-items: center;
    min-height: 172px;
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    transition: background-color var(--motion-fast) var(--ease-out), border-color var(--motion-fast) var(--ease-out);
  }

  /* 悬停时只增强光线与分隔线，不移动卡片。 */
  .post-card:hover {
    border-color: var(--border-strong);
    background: radial-gradient(ellipse 72% 130% at 12% 50%, var(--glow-lamp), transparent 68%);
    text-decoration: none;
  }

  .post-card__date {
    color: var(--warm);
    font-size: 0.86rem;
    font-weight: 800;
    line-height: 1.2;
    white-space: nowrap;
  }

  .post-card__cover {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    -webkit-mask-image: radial-gradient(ellipse 98% 94% at 50% 50%, #000 82%, transparent 100%);
    mask-image: radial-gradient(ellipse 98% 94% at 50% 50%, #000 82%, transparent 100%);
  }

  .post-card__body {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  .post-card h2 {
    margin: 0;
    color: var(--text);
    font-size: clamp(1.05rem, 2vw, 1.22rem);
    line-height: 1.35;
    overflow-wrap: anywhere;
    transition: color var(--motion-fast) var(--ease-out);
  }

  .post-card:hover h2 {
    color: var(--accent-strong);
  }

  .post-card__description {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  /* 无封面时使用普通标题字体显示作者名。 */
  .post-card__fallback {
    display: grid;
    width: 100%;
    aspect-ratio: 4 / 3;
    place-items: center;
    background: radial-gradient(ellipse 70% 80% at 50% 42%, var(--surface-muted), transparent 72%);
    color: color-mix(in srgb, var(--cinnabar) 58%, transparent);
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: 0.2em;
  }

  .post-card__cue {
    align-self: center;
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 800;
    white-space: nowrap;
  }

  .post-card:hover .post-card__cue {
    color: var(--accent-strong);
  }

  @media (max-width: 760px) {
    .post-card {
      grid-template-columns: minmax(94px, 132px) minmax(0, 1fr);
      gap: var(--space-4);
      min-height: 0;
      padding: var(--space-4) 0;
    }

    .post-card__date {
      grid-column: 1 / -1;
    }

    .post-card__cue {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .post-card {
      grid-template-columns: 1fr;
    }

    .post-card__cover {
      max-width: 220px;
    }
  }

</style>

<style is:global>
  .post-card__cover img {
    width: 100% !important;
    height: 100% !important;
    aspect-ratio: 4 / 3 !important;
    object-fit: cover !important;
    display: block !important;
  }
</style>
