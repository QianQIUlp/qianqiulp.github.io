---
// 朱砂小方印「千秋」：站点唯一的签名级图形元素，克制使用。
// 字形来自自托管书体子集 QiuBrush（scripts/subset-signature-font.py 可再生成）。
interface Props {
  size?: number;
  class?: string;
}

const { size = 34, class: className = '' } = Astro.props;
---

<svg
  class:list={['seal', className]}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role="img"
  aria-label="千秋印章"
>
  <rect class="seal__ground" x="5" y="5" width="54" height="54" rx="7" />
  <text class="seal__glyph" x="32" y="28" text-anchor="middle">千</text>
  <text class="seal__glyph" x="32" y="53" text-anchor="middle">秋</text>
</svg>

<style>
  .seal {
    display: block;
    color: var(--cinnabar);
  }

  .seal__ground {
    fill: currentColor;
  }

  .seal__glyph {
    fill: var(--paper);
    stroke: var(--paper);
    stroke-width: 0.45px;
    paint-order: stroke;
    font-family: var(--font-brush);
    font-size: 22px;
  }
</style>
