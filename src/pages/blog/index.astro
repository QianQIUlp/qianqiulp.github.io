---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { type Lang } from '../../i18n';
import '../../styles/blog.css';

const lang: Lang = Astro.props.lang === 'en' ? 'en' : 'zh';
const isEnglish = lang === 'en';
const copy = isEnglish ? {
  title: "Writing · Qianqiu's Site",
  description: "Qianqiu's technical notes, personal reflections, and practical guides.",
  imageAlt: "Cover image for writing on Qianqiu's site",
  kicker: 'Articles and notes', heading: 'Writing',
  lead: 'Technical notes, personal reflections, and practical guides, arranged in reverse chronological order.',
  summaryAria: 'Writing summary', articles: 'articles', topics: 'topics', listAria: 'Article list',
} : {
  title: '文章 · 千秋的个人站',
  description: '千秋的技术笔记、个人思考和实用指南。',
  imageAlt: '千秋的个人站文章封面图',
  kicker: '文章与笔记', heading: '文章',
  lead: '技术笔记、个人思考和实用指南，按时间倒序排列。',
  summaryAria: '文章概览', articles: '篇', topics: '标签', listAria: '文章列表',
};

const posts = isEnglish
  ? await getCollection('postsEn')
  : await getCollection('posts');
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const tagCount = new Set(sortedPosts.flatMap((post) => post.data.tags)).size;
---

<BaseLayout
  lang={lang}
  title={copy.title}
  description={copy.description}
  ogTitle={copy.title}
  ogDescription={copy.description}
  ogUrl={`https://qianqiulp.github.io${isEnglish ? '/en/blog/' : '/blog/'}`}
  ogImage="/assets/og/site.svg"
  ogImageAlt={copy.imageAlt}
  bodyClass="page-blog-index"
>
  <main class="page-shell" id="main-content" tabindex="-1">
    <header class="page-hero archive-hero">
      <div>
        <p class="page-kicker">{copy.kicker}</p>
        <h1 class="hero-title hero-title--compact">{copy.heading}</h1>
        <p class="hero-lead">{copy.lead}</p>
      </div>
      <dl class="archive-summary" aria-label={copy.summaryAria}>
        <div>
          <dt>{sortedPosts.length}</dt>
          <dd>{copy.articles}</dd>
        </div>
        <div>
          <dt>{tagCount}</dt>
          <dd>{copy.topics}</dd>
        </div>
      </dl>
    </header>

    <section class="post-ledger" aria-label={copy.listAria}>
      {sortedPosts.map((post, index) => (
        <PostCard post={post} revealOrder={index % 3} lang={lang} />
      ))}
    </section>
  </main>
</BaseLayout>
