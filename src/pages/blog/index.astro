---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import '../../styles/blog.css';

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const tagCount = new Set(sortedPosts.flatMap((post) => post.data.tags)).size;
---

<BaseLayout
  title="博客 · Qiu 的小屋"
  description="Qiu 的小屋 · 博客，记录随想、折腾笔记与一些不想忘掉的东西。"
  ogTitle="博客 · Qiu 的小屋"
  ogDescription="Qiu 的小屋 · 博客，记录随想、折腾笔记与一些不想忘掉的东西。"
  ogUrl="https://qianqiulp.github.io/blog/"
  ogImage="/assets/og/site.svg"
  ogImageAlt="Qiu 的小屋博客封面图"
  bodyClass="page-blog-index"
>
  <main class="page-shell" id="main-content" tabindex="-1">
    <header class="page-hero">
      <p class="eyebrow">Archive</p>
      <h1 class="hero-title hero-title--compact">文章</h1>
      <p class="hero-lead">记录随想、折腾笔记与一些不想忘掉的东西。按时间倒序排列，适合慢慢翻。</p>
      <p class="meta-line">{sortedPosts.length} 篇文章 · {tagCount} 个主题</p>
    </header>

    <section class="post-grid" aria-label="文章列表">
      {sortedPosts.map((post) => (
        <PostCard post={post} />
      ))}
    </section>
  </main>
</BaseLayout>
