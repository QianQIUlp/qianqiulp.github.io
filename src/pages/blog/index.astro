---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import '../../styles/blog.css';

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const tagCount = new Set(sortedPosts.flatMap((post) => post.data.tags)).size;
---

<BaseLayout
  title="博客 · Qiu 的小屋"
  description="Qiu 的小屋 · 博客，记录随想、折腾笔记与一些不想忘掉的东西。"
  ogTitle="博客 · Qiu 的小屋"
  ogDescription="Qiu 的小屋 · 博客，记录随想、折腾笔记与一些不想忘掉的东西。"
  ogUrl="https://qianqiulp.github.io/blog/"
  ogImage="/assets/og/site.svg"
  ogImageAlt="Qiu 的小屋博客封面图"
  bodyClass="page-blog-index"
>
  <main class="page-shell" id="main-content" tabindex="-1">
    <header class="page-hero archive-hero">
      <div>
        <p class="eyebrow">Archive Ledger</p>
        <h1 class="hero-title hero-title--compact">文章索引</h1>
        <p class="hero-lead">记录随想、折腾笔记与一些不想忘掉的东西。这里按时间倒序排成阅读索引，方便慢慢翻。</p>
      </div>
      <dl class="archive-summary" aria-label="文章归档概览">
        <div>
          <dt>{sortedPosts.length}</dt>
          <dd>篇文章</dd>
        </div>
        <div>
          <dt>{tagCount}</dt>
          <dd>个主题</dd>
        </div>
      </dl>
    </header>

    <section class="post-ledger" aria-label="文章列表">
      {sortedPosts.map((post) => (
        <PostCard post={post} />
      ))}
    </section>
  </main>
</BaseLayout>
