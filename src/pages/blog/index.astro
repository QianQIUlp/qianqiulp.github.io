---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title="博客 · Qiu 的小屋"
  description="Qiu 的小屋 · 博客，记录随想、折腾笔记与一些不想忘掉的东西。"
  ogTitle="博客 · Qiu 的小屋"
  ogDescription="Qiu 的小屋 · 博客，记录随想、折腾笔记与一些不想忘掉的东西。"
  ogUrl="https://qianqiulp.github.io/blog/"
  ogImage="/assets/og/site.svg"
  ogImageAlt="Qiu 的小屋博客封面图"
  bodyClass="page-blog-index"
>
  <slot slot="extraCss" name="extraCss">
    <link rel="stylesheet" href="/blog/blog.css?v=2" />
  </slot>

  <main class="page">
    <header class="topbar">
      <div>
        <p class="eyebrow">🪶 Qiu 的小屋</p>
        <h1>博客</h1>
        <p class="lead">记录随想、折腾笔记与一些不想忘掉的东西。</p>
      </div>
      <nav>
        <a class="back-link" href="/">← 回首页</a>
      </nav>
    </header>

    <section class="post-grid" aria-label="文章列表">
      {sortedPosts.map((post) => (
        <PostCard post={post} />
      ))}
    </section>
  </main>

</BaseLayout>

