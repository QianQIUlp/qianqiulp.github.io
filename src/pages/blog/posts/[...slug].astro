---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/blog.css';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return Promise.all(
    posts.map(async (post) => {
      const { Content, headings } = await render(post);
      return {
        params: { slug: post.id },
        props: { post, Content, headings },
      };
    })
  );
}

const { post, Content, headings } = Astro.props;
const showToc = post.data.toc === true;
const formattedDate = post.data.date.toISOString().slice(0, 10);
const displayDate = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(post.data.date);
---

<BaseLayout
  title={`${post.data.title} · Qiu 的小屋`}
  description={post.data.description}
  ogType="article"
  ogTitle={post.data.title}
  ogDescription={post.data.description}
  ogUrl={`https://qianqiulp.github.io/blog/posts/${post.id}/`}
  ogImage={post.data.ogImage ? post.data.ogImage.src : '/assets/og/site.svg'}
  ogImageAlt={post.data.ogImageAlt || `${post.data.title} 文章封面`}
  bodyClass="page-post"
>
  <main class="page-shell page-shell--reading article-shell" id="main-content" tabindex="-1">
    <a class="article-back" href="/blog/">返回文章列表</a>

    <article class="post-article">
      <header class:list={['post-header', { 'post-header--with-image': post.data.ogImage, 'post-header--fallback': !post.data.ogImage }]}>
        {post.data.ogImage && (
          <Image
            class="post-cover"
            src={post.data.ogImage}
            alt=""
            loading="eager"
            fetchpriority="high"
            aria-hidden="true"
          />
        )}

        <div class="post-header__scrim" aria-hidden="true"></div>

        <div class="post-header__copy">
          <p class="eyebrow">Long-form folio</p>
          <h1>{post.data.title}</h1>
          <p class="post-description">{post.data.description}</p>
          <div class="post-meta">
            <time datetime={formattedDate}>{displayDate}</time>
            <ul class="tag-list" aria-label="文章标签">
              {post.data.tags.map((tag: string) => (
                <li><span class="tag-pill">{tag}</span></li>
              ))}
            </ul>
          </div>
        </div>
      </header>

      {showToc && headings && headings.length > 0 && (
        <nav class="toc-block" aria-label="文章目录">
          <div class="toc-header">目录</div>
          <ul class="toc-list">
            {headings.map((heading) => (
              <li class={`toc-item depth-${heading.depth}`}>
                <a href={`#${heading.slug}`} data-toc-link>{heading.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <div class="post-content">
        <Content />
      </div>

      {post.data.license && (
        <footer class="post-license">
          <span>授权协议</span>
          <p>{post.data.license}</p>
        </footer>
      )}
    </article>
  </main>

  {showToc && headings && headings.length > 0 && (
    <script is:inline>
      (function(){
        var links = Array.prototype.slice.call(document.querySelectorAll('[data-toc-link]'));
        if (!links.length) return;

        var headings = links
          .map(function(link){ return document.getElementById(decodeURIComponent(link.hash.slice(1))); })
          .filter(Boolean);
        if (!headings.length) return;

        function setActive(id) {
          links.forEach(function(link){
            var active = decodeURIComponent(link.hash.slice(1)) === id;
            if (active) {
              link.setAttribute('aria-current', 'true');
            } else {
              link.removeAttribute('aria-current');
            }
          });
        }

        if (!('IntersectionObserver' in window)) {
          setActive(headings[0].id);
          return;
        }

        var visible = new Map();
        var observer = new IntersectionObserver(function(entries){
          entries.forEach(function(entry){
            visible.set(entry.target.id, entry.isIntersecting);
          });

          var activeHeading = headings.find(function(heading){ return visible.get(heading.id); })
            || headings.slice().reverse().find(function(heading){ return heading.getBoundingClientRect().top <= 120; })
            || headings[0];

          setActive(activeHeading.id);
        }, {
          rootMargin: '-20% 0px -70% 0px',
          threshold: 0,
        });

        headings.forEach(function(heading){ observer.observe(heading); });
        setActive(headings[0].id);
      })();
    </script>
  )}

  <Fragment slot="extraHead">
    <meta property="article:published_time" content={formattedDate} />
    <meta property="article:author" content="QianQIUlp" />
    <meta property="article:section" content={post.data.tags[0]} />
    {post.data.tags.map((tag: string) => (
      <meta property="article:tag" content={tag} />
    ))}
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": post.data.title,
      "description": post.data.description,
      "image": [
        new URL(post.data.ogImage ? post.data.ogImage.src : '/assets/og/site.svg', Astro.site).href
      ],
      "datePublished": formattedDate,
      "author": [{
        "@type": "Person",
        "name": "QianQIUlp",
        "url": "https://github.com/qianqiulp"
      }]
    })} />
  </Fragment>
</BaseLayout>
