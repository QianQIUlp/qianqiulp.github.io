---
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { localizedPath, type Lang } from '../../../i18n';
import { getPostStaticPaths } from '../../../lib/post-static-paths';
import '../../../styles/blog.css';

export const getStaticPaths = () => getPostStaticPaths('posts');

const { post, Content, headings, IntroContent } = Astro.props;
const lang: Lang = Astro.props.lang === 'en' ? 'en' : 'zh';
const isEnglish = lang === 'en';
const copy = isEnglish ? {
  site: "Qiu's Room", start: 'Article start', back: 'Back to writing', kicker: 'Long read',
  languageNote: '', tags: 'Article tags',
  license: 'License · end note', tocAria: 'Open or close the table of contents', toc: 'Contents', close: 'Close',
  imageAlt: 'Article cover',
} : {
  site: 'Qiu 的小屋', start: '文章开头', back: '返回文章列表', kicker: '长文',
  languageNote: '', tags: '文章标签', license: '授权协议 · 文末记',
  tocAria: '展开或收起文章目录', toc: '目录', close: '收起', imageAlt: '文章封面',
};
const tocHeadings = (headings ?? []).filter((heading) => heading.depth >= 2 && heading.depth <= 4);
const tocItems = [
  { slug: 'article-start', text: copy.start, depth: 2 },
  ...tocHeadings,
];
const formattedDate = post.data.date.toISOString().slice(0, 10);
const displayDate = new Intl.DateTimeFormat(isEnglish ? 'en-US' : 'zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(post.data.date);
---

<BaseLayout
  lang={lang}
  title={`${post.data.title} · ${copy.site}`}
  description={post.data.description}
  ogType="article"
  ogTitle={post.data.title}
  ogDescription={post.data.description}
  ogUrl={`https://qianqiulp.github.io${localizedPath(`/blog/posts/${post.id}/`, lang)}`}
  ogImage={post.data.ogImage ? post.data.ogImage.src : '/assets/og/site.svg'}
  ogImageAlt={post.data.ogImageAlt || `${post.data.title} ${copy.imageAlt}`}
  bodyClass="page-post"
>
  <main class="page-shell page-shell--reading article-shell" id="main-content" tabindex="-1">
    <a class="article-back" href={localizedPath('/blog/', lang)}>{copy.back}</a>

    <article class="post-article">
      <span class="article-start-anchor" id="article-start" aria-hidden="true"></span>
      <header class:list={['post-header', { 'post-header--with-image': post.data.ogImage, 'post-header--fallback': !post.data.ogImage }]}>
        <div class="post-header__copy">
          <p class="page-kicker">{copy.kicker}</p>
          {copy.languageNote && <p class="article-language-note" lang="en">{copy.languageNote}</p>}
          <h1>{post.data.title}</h1>
          <p class="post-description">{post.data.description}</p>
          <div class="post-meta">
            <time datetime={formattedDate}>{displayDate}</time>
            <ul class="tag-list" aria-label={copy.tags}>
              {post.data.tags.map((tag: string) => (
                <li><span class="tag-pill">{tag}</span></li>
              ))}
            </ul>
          </div>
        </div>

        {post.data.ogImage && (
          <div class="post-header__media">
            <Image
              class="post-cover"
              src={post.data.ogImage}
              alt=""
              loading="eager"
              fetchpriority="high"
              aria-hidden="true"
            />
          </div>
        )}
      </header>

      <div class:list={[
        'article-reading-grid',
        {
          'has-intro': Boolean(IntroContent),
        },
      ]}>
        {IntroContent && (
          <div class="post-intro">
            <IntroContent />
          </div>
        )}

        <div class="post-content">
          <Content />
        </div>

        {post.data.license && (
          <footer class="post-license">
            <div>
              <span>{copy.license}</span>
              <p>{post.data.license}</p>
            </div>
          </footer>
        )}
      </div>
    </article>
  </main>

  <details class="toc-drawer" data-toc-drawer>
    <summary class="toc-toggle" aria-label={copy.tocAria}>
      <span class="toc-toggle__open">{copy.toc}</span>
      <span class="toc-toggle__close">{copy.close}</span>
    </summary>
    <nav class="toc-block" aria-label={copy.toc}>
      <div class="toc-header">{copy.toc}</div>
      <ul class="toc-list">
        {tocItems.map((heading) => (
          <li class={`toc-item depth-${heading.depth}`}>
            <a href={`#${heading.slug}`} data-toc-link>{heading.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  </details>

  {tocItems.length > 0 && (
    <script is:inline>
      (function(){
        var links = Array.prototype.slice.call(document.querySelectorAll('[data-toc-link]'));
        if (!links.length) return;

        var headings = links
          .map(function(link){ return document.getElementById(decodeURIComponent(link.hash.slice(1))); })
          .filter(Boolean);
        if (!headings.length) return;

        function setActive(id) {
          links.forEach(function(link){
            var active = decodeURIComponent(link.hash.slice(1)) === id;
            if (active) {
              link.setAttribute('aria-current', 'true');
            } else {
              link.removeAttribute('aria-current');
            }
          });
        }

        if (!('IntersectionObserver' in window)) {
          setActive(headings[0].id);
          return;
        }

        var visible = new Map();
        var observer = new IntersectionObserver(function(entries){
          entries.forEach(function(entry){
            visible.set(entry.target.id, entry.isIntersecting);
          });

          var activeHeading = headings.find(function(heading){ return visible.get(heading.id); })
            || headings.slice().reverse().find(function(heading){ return heading.getBoundingClientRect().top <= 120; })
            || headings[0];

          setActive(activeHeading.id);
        }, {
          rootMargin: '-20% 0px -70% 0px',
          threshold: 0,
        });

        headings.forEach(function(heading){ observer.observe(heading); });
        setActive(headings[0].id);
      })();
    </script>
  )}

  <Fragment slot="extraHead">
    <meta property="article:published_time" content={formattedDate} />
    <meta property="article:author" content="QianQIUlp" />
    <meta property="article:section" content={post.data.tags[0]} />
    {post.data.tags.map((tag: string) => (
      <meta property="article:tag" content={tag} />
    ))}
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": post.data.title,
      "description": post.data.description,
      "image": [
        new URL(post.data.ogImage ? post.data.ogImage.src : '/assets/og/site.svg', Astro.site).href
      ],
      "datePublished": formattedDate,
      "author": [{
        "@type": "Person",
        "name": "QianQIUlp",
        "url": "https://github.com/qianqiulp"
      }]
    })} />
  </Fragment>
</BaseLayout>
