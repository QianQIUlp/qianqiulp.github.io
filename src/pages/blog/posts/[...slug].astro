---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return Promise.all(
    posts.map(async (post) => {
      const { Content, headings } = await render(post);
      return {
        params: { slug: post.id },
        props: { post, Content, headings },
      };
    })
  );
}

const { post, Content, headings } = Astro.props;
const showToc = post.id.includes('ssh') || post.id.includes('linux');
import '../../../styles/blog.css';
---

<BaseLayout
  title={`${post.data.title} · Qiu 的小屋`}
  description={post.data.description}
  ogType="article"
  ogTitle={post.data.title}
  ogDescription={post.data.description}
  ogUrl={`https://qianqiulp.github.io/blog/posts/${post.id}/`}
  ogImage={post.data.ogImage ? post.data.ogImage.src : '/assets/og/site.svg'}
  ogImageAlt={post.data.ogImageAlt || `${post.data.title} 文章封面`}
  bodyClass=""
>

  <nav>
    <a href="/">← 回首页</a> ·&nbsp;
    <a href="/blog/">博客</a>
  </nav>

  <article>
    <header>
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={post.data.date.toISOString().slice(0, 10)}>
          {post.data.date.toISOString().slice(0, 10)}
        </time>
        {post.data.tags.map((tag: string) => (
          <Fragment> · <span class="tag">{tag}</span></Fragment>
        ))}
      </p>
    </header>

    {showToc && headings && headings.length > 0 && (
      <div class="toc-block" aria-label="文章目录">
        <div class="toc-header">📄 目录</div>
        <ul class="toc-list">
          {headings.map((heading) => (
            <li class={`toc-item depth-${heading.depth}`}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <Content />
  </article>

  <footer><a href="/blog/">← 更多文章</a></footer>

  <!-- extra head: article meta tags -->
  <Fragment slot="extraHead">
    <meta property="article:published_time" content={post.data.date.toISOString().slice(0, 10)} />
    <meta property="article:author" content="QianQIUlp" />
    <meta property="article:section" content={post.data.tags[0]} />
    {post.data.tags.map((tag: string) => (
      <meta property="article:tag" content={tag} />
    ))}
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": post.data.title,
      "description": post.data.description,
      "image": [
        new URL(post.data.ogImage ? post.data.ogImage.src : '/assets/og/site.svg', Astro.site).href
      ],
      "datePublished": post.data.date.toISOString().slice(0, 10),
      "author": [{
        "@type": "Person",
        "name": "QianQIUlp",
        "url": "https://github.com/qianqiulp"
      }]
    })} />
  </Fragment>
</BaseLayout>

<style>
  /* Notion-like Table of Contents Block */
  .toc-block {
    background: var(--surface-callout);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    margin: 2rem 0;
    max-width: 100%;
  }

  .toc-header {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .toc-item {
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .toc-item a {
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: all 0.2s;
  }

  .toc-item a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  /* Notion Hierarchy Indentations */
  .toc-item.depth-2 {
    padding-left: 0;
  }

  .toc-item.depth-3 {
    padding-left: 1.25rem;
    font-size: 0.9rem;
  }

  .toc-item.depth-4 {
    padding-left: 2.5rem;
    font-size: 0.85rem;
  }
</style>
