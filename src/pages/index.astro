---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import practiceRoomBackground from '../assets/home/practice-room-background.png';
import qiuRelicGuitar from '../assets/home/qiu-relic-guitar.png';
import '../styles/home-room.css';
---

<BaseLayout
  title="千秋的个人主页 · Qiu 的小屋"
  description="走进千秋的个人房间，从书桌、工作台与吉他认识他的构建、写作和生活。"
  ogTitle="千秋的个人主页 · Qiu 的小屋"
  ogDescription="从房间里的东西，慢慢认识千秋。"
  ogUrl="https://qianqiulp.github.io/"
  ogImage="/assets/og/site.svg"
  ogImageAlt="千秋的个人主页封面图"
  bodyClass="page-home page-home--room"
>
  <main
    class="room-home"
    id="main-content"
    tabindex="-1"
    data-room-stage
    data-room-view="overview"
  >
    <div class="room-camera" aria-hidden="true">
      <div class="room-camera__world">
        <Image
          class="room-scene"
          src={practiceRoomBackground}
          alt=""
          loading="eager"
          fetchpriority="high"
          widths={[768, 1280, 1536]}
          sizes="100vw"
        />
        <Image
          class="room-guitar"
          src={qiuRelicGuitar}
          alt=""
          loading="eager"
          widths={[420, 640, 860]}
          sizes="(max-width: 640px) 92vw, 46vw"
        />
      </div>
    </div>

    <section class="room-intro" aria-labelledby="home-title">
      <p class="room-intro__eyebrow">Personal room / Qiu</p>
      <h1 id="home-title">我是千秋。</h1>
      <p>选择一个方向，走近一点。</p>
    </section>

    <nav class="room-destinations" aria-label="从房间里认识千秋">
      <a
        class="room-hotspot room-hotspot--writing"
        href="/blog/"
        data-room-destination="writing"
        data-room-name="书桌"
      >
        <span>文章</span>
      </a>
      <a
        class="room-hotspot room-hotspot--projects"
        href="/projects/"
        data-room-destination="projects"
        data-room-name="工作台"
      >
        <span>作品</span>
      </a>
      <a
        class="room-hotspot room-hotspot--life"
        href="#life-note"
        data-room-destination="life"
        data-room-name="吉他"
      >
        <span>吉他与生活</span>
      </a>
    </nav>

    <aside class="room-life-note" id="life-note" aria-labelledby="life-note-title" tabindex="-1">
      <p class="room-life-note__eyebrow">Guitar & life</p>
      <h2 id="life-note-title">生活不是作品集的边角料。</h2>
      <p>
        我也从游戏、关系、练琴和日常经验里理解自己。这里不急着把每件事都变成结论，只留下值得再听一次的回声。
      </p>
      <div class="room-life-note__links" aria-label="站外联系方式">
        <a href="https://github.com/qianqiulp" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a
          href="https://space.bilibili.com/400485069?spm_id_from=333.33.0.0"
          target="_blank"
          rel="noopener noreferrer"
        >Bilibili</a>
      </div>
    </aside>

    <a class="room-reset" href="#main-content" data-room-reset>回到房间</a>
    <p class="room-hint" aria-hidden="true">点击物件，让视线过去。</p>
    <p class="room-sr-only" aria-live="polite" data-room-status></p>
  </main>

  <script is:inline>
    (function(){
      var stage = document.querySelector('[data-room-stage]');
      if (!stage) return;

      var destinations = Array.prototype.slice.call(
        stage.querySelectorAll('[data-room-destination]')
      );
      var reset = stage.querySelector('[data-room-reset]');
      var lifeNote = document.getElementById('life-note');
      var status = stage.querySelector('[data-room-status]');
      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      var navigationTimer = 0;

      function announce(message) {
        if (status) status.textContent = message;
      }

      function showOverview(options) {
        window.clearTimeout(navigationTimer);
        stage.dataset.roomView = 'overview';
        stage.removeAttribute('aria-busy');
        announce('已回到房间全景。');
        if (options && options.focus && reset) {
          var firstDestination = destinations[0];
          if (firstDestination) firstDestination.focus();
        }
      }

      destinations.forEach(function(link){
        link.addEventListener('click', function(event){
          if (
            event.defaultPrevented ||
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey
          ) return;

          var destination = link.getAttribute('data-room-destination');
          var name = link.getAttribute('data-room-name') || link.textContent.trim();
          if (!destination) return;

          if (destination === 'life') {
            event.preventDefault();
            stage.dataset.roomView = 'life';
            announce('视线移向吉他，生活侧记已经展开。');
            window.setTimeout(function(){
              if (lifeNote) lifeNote.focus({ preventScroll: true });
            }, reduceMotion.matches ? 0 : 620);
            return;
          }

          if (reduceMotion.matches) return;

          event.preventDefault();
          stage.dataset.roomView = destination;
          stage.setAttribute('aria-busy', 'true');
          announce('视线移向' + name + '，即将进入。');

          navigationTimer = window.setTimeout(function(){
            window.location.assign(link.href);
          }, 820);
        });
      });

      if (reset) {
        reset.addEventListener('click', function(event){
          event.preventDefault();
          history.replaceState(null, '', window.location.pathname);
          showOverview({ focus: true });
        });
      }

      window.addEventListener('keydown', function(event){
        if (event.key === 'Escape' && stage.dataset.roomView !== 'overview') {
          showOverview({ focus: true });
        }
      });

      window.addEventListener('pageshow', function(){
        showOverview();
      });
    })();
  </script>
</BaseLayout>
