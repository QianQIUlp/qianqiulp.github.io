---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { featuredProjects } from '../data/projects';
import roomOverview from '../assets/home/practice-room-overview-4k.webp';
import roomWriting from '../assets/home/practice-room-writing-4k.webp';
import roomProjects from '../assets/home/practice-room-projects-4k.webp';
import roomCurtain from '../assets/home/practice-room-curtain-4k.webp';
import qiuRelicGuitar from '../assets/home/qiu-relic-guitar-4k.webp';
import '../styles/home-room.css';

const posts = await getCollection('posts');
const latestPosts = posts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const roomProjectsList = featuredProjects.slice(0, 3);

const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
  month: '2-digit',
  day: '2-digit',
});
const formatDate = (date: Date) => date.toISOString().slice(0, 10);
---

<BaseLayout
  title="千秋的个人主页 · Qiu 的小屋"
  description="走进千秋的个人房间，从书桌、工作台与吉他认识他的构建、写作和生活。"
  ogTitle="千秋的个人主页 · Qiu 的小屋"
  ogDescription="从房间里的东西，慢慢认识千秋。"
  ogUrl="https://qianqiulp.github.io/"
  ogImage="/assets/og/site.svg"
  ogImageAlt="千秋的个人主页封面图"
  bodyClass="page-home page-home--room"
>
  <main
    class="room-home"
    id="main-content"
    tabindex="-1"
    data-room-stage
    data-room-view="overview"
    data-room-moving="false"
  >
    <div class="room-camera">
      <div class="room-canvas">
        <div class="room-world" aria-hidden="true">
          <Image
            class="room-scene room-scene--overview"
            src={roomOverview}
            alt=""
            loading="eager"
            fetchpriority="high"
            widths={[1280, 1920, 2560, 3840]}
            sizes="max(100vw, 177.78vh)"
            quality={82}
          />
        </div>

        <Image
          class="room-curtain"
          src={roomCurtain}
          alt=""
          loading="eager"
          fetchpriority="low"
          widths={[1280, 1920, 2560, 3840]}
          sizes="max(100vw, 177.78vh)"
          quality={84}
          aria-hidden="true"
        />

        <div class="room-guitar-wrap" aria-hidden="true">
          <span class="room-guitar-shadow"></span>
          <Image
            class="room-guitar"
            src={qiuRelicGuitar}
            alt=""
            loading="eager"
            widths={[640, 960, 1440, 2160]}
            sizes="(max-width: 640px) 116vw, 44vw"
            quality={90}
          />
        </div>

        <section
          class="room-focus-layer room-focus-layer--writing"
          id="writing-desk"
          data-room-panel="writing"
          aria-labelledby="writing-desk-title"
        >
          <Image
            class="room-focus-plate"
            src={roomWriting}
            alt=""
            loading="lazy"
            fetchpriority="low"
            widths={[1280, 1920, 2560, 3840]}
            sizes="max(100vw, 177.78vh)"
            quality={80}
            aria-hidden="true"
          />

          <div class="room-monitor-surface" tabindex="-1">
            <header class="room-surface-heading">
              <h2 id="writing-desk-title">最近的文字</h2>
              <a href="/blog/">全部文章</a>
            </header>
            <ol class="room-writing-list">
              {latestPosts.map((post, index) => (
                <li>
                  <a
                    href={`/blog/posts/${post.id}/`}
                    data-room-autofocus={index === 0 ? '' : undefined}
                  >
                    <time datetime={formatDate(post.data.date)}>{dateFormatter.format(post.data.date)}</time>
                    <span>{post.data.title}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </section>

        <section
          class="room-focus-layer room-focus-layer--projects"
          id="project-workbench"
          data-room-panel="projects"
          aria-labelledby="project-workbench-title"
        >
          <Image
            class="room-focus-plate"
            src={roomProjects}
            alt=""
            loading="lazy"
            fetchpriority="low"
            widths={[1280, 1920, 2560, 3840]}
            sizes="max(100vw, 177.78vh)"
            quality={80}
            aria-hidden="true"
          />

          <div class="room-workbench-surface" tabindex="-1">
            <header class="room-surface-heading">
              <h2 id="project-workbench-title">工程档案</h2>
              <a href="/projects/">完整作品页</a>
            </header>
            <ol class="room-project-list">
              {roomProjectsList.map((project, index) => (
                <li>
                  <a
                    href={`/projects/#project-${index + 1}`}
                    data-room-autofocus={index === 0 ? '' : undefined}
                  >
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    <strong>{project.displayName}</strong>
                    <small>{project.status}</small>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </section>

        <div class="room-atmosphere" aria-hidden="true"></div>

        <div class="room-petals" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>
    </div>

    <section class="room-intro" aria-labelledby="home-title">
      <h1 id="home-title">我是千秋。</h1>
      <p>选择一个方向，走近一点。</p>
    </section>

    <nav class="room-destinations" aria-label="从房间里认识千秋">
      <a
        class="room-hotspot room-hotspot--writing"
        href="#writing-desk"
        data-room-destination="writing"
        data-room-name="书桌"
        aria-label="走近书桌，查看文章"
      >
        <span aria-hidden="true"><small>书桌</small>文章</span>
      </a>
      <a
        class="room-hotspot room-hotspot--projects"
        href="#project-workbench"
        data-room-destination="projects"
        data-room-name="工作台"
        aria-label="走近工作台，查看作品"
      >
        <span aria-hidden="true"><small>工作台</small>作品</span>
      </a>
      <a
        class="room-hotspot room-hotspot--life"
        href="#life-corner"
        data-room-destination="life"
        data-room-name="吉他"
        aria-label="走近吉他，查看生活侧记"
      >
        <span aria-hidden="true"><small>吉他</small>生活</span>
      </a>
    </nav>

    <aside
      class="room-life-note"
      id="life-corner"
      data-room-panel="life"
      aria-labelledby="life-note-title"
      tabindex="-1"
    >
      <h2 id="life-note-title">生活不是作品集的边角料。</h2>
      <p>
        我也从游戏、关系、练琴和日常经验里理解自己。这里不急着把每件事都变成结论，只留下值得再听一次的回声。
      </p>
      <div class="room-life-note__links" aria-label="站外联系方式">
        <a href="https://github.com/qianqiulp" target="_blank" rel="noopener noreferrer" data-room-autofocus>GitHub</a>
        <a
          href="https://space.bilibili.com/400485069?spm_id_from=333.33.0.0"
          target="_blank"
          rel="noopener noreferrer"
        >Bilibili</a>
      </div>
    </aside>

    <a class="room-reset" href="/" data-room-reset>回到房间</a>
    <p class="room-hint" aria-hidden="true">点击物件，让视线走过去。</p>
    <div class="room-camera-progress" aria-hidden="true"><span></span></div>
    <p class="room-sr-only" aria-live="polite" data-room-status></p>
  </main>

  <script is:inline>
    (function(){
      var stage = document.querySelector('[data-room-stage]');
      if (!stage) return;

      var destinations = Array.prototype.slice.call(
        stage.querySelectorAll('[data-room-destination]')
      );
      var panels = Array.prototype.slice.call(stage.querySelectorAll('[data-room-panel]'));
      var destinationNav = stage.querySelector('.room-destinations');
      var reset = stage.querySelector('[data-room-reset]');
      var status = stage.querySelector('[data-room-status]');
      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      var transitionTimer = 0;
      var transitionDuration = 2400;
      var hashByView = {
        writing: '#writing-desk',
        projects: '#project-workbench',
        life: '#life-corner'
      };
      var viewByHash = {
        '#writing-desk': 'writing',
        '#project-workbench': 'projects',
        '#life-corner': 'life'
      };

      function announce(message) {
        if (status) status.textContent = message;
      }

      function setPanelAccess(view) {
        if (destinationNav) {
          destinationNav.toggleAttribute('inert', view !== 'overview');
        }
        panels.forEach(function(panel){
          var isActive = panel.getAttribute('data-room-panel') === view;
          panel.toggleAttribute('inert', !isActive);
          panel.setAttribute('aria-hidden', isActive ? 'false' : 'true');
        });
      }

      function settle(view, shouldFocus) {
        stage.dataset.roomMoving = 'false';
        document.body.dataset.roomView = view;
        stage.removeAttribute('aria-busy');

        if (!shouldFocus) return;
        var panel = stage.querySelector('[data-room-panel="' + view + '"]');
        var focusTarget = panel && panel.querySelector('[data-room-autofocus]');
        if (focusTarget) focusTarget.focus({ preventScroll: true });
        else if (panel) panel.focus({ preventScroll: true });
      }

      function moveTo(view, options) {
        if (!hashByView[view]) return;
        if (stage.dataset.roomMoving === 'true' && !(options && options.force)) return;
        if (stage.dataset.roomView === view && !(options && options.force)) return;

        window.clearTimeout(transitionTimer);
        stage.removeAttribute('data-room-preview');
        setPanelAccess(view);
        stage.dataset.roomMoving = reduceMotion.matches ? 'false' : 'true';
        stage.dataset.roomView = view;
        document.body.dataset.roomView = view;
        stage.setAttribute('aria-busy', 'true');

        if (!options || options.history !== false) {
          history.pushState({ roomView: view }, '', hashByView[view]);
        }

        var destination = destinations.find(function(link){
          return link.getAttribute('data-room-destination') === view;
        });
        var name = destination && destination.getAttribute('data-room-name');
        announce('视线正在走向' + (name || '房间里的物件') + '。');

        if (reduceMotion.matches) {
          settle(view, !options || options.focus !== false);
          return;
        }

        transitionTimer = window.setTimeout(function(){
          announce('已经走到' + (name || '目标') + '前。');
          settle(view, !options || options.focus !== false);
        }, transitionDuration);
      }

      function showOverview(options) {
        window.clearTimeout(transitionTimer);
        stage.removeAttribute('data-room-preview');
        var wasOverview = stage.dataset.roomView === 'overview';
        stage.dataset.roomMoving = reduceMotion.matches || wasOverview ? 'false' : 'true';
        stage.dataset.roomView = 'overview';
        document.body.dataset.roomView = 'overview';
        stage.setAttribute('aria-busy', 'true');

        if (!options || options.history !== false) {
          history.replaceState({ roomView: 'overview' }, '', window.location.pathname + window.location.search);
        }

        announce('视线正在回到房间全景。');

        var finish = function(){
          setPanelAccess('overview');
          stage.dataset.roomMoving = 'false';
          stage.removeAttribute('aria-busy');
          announce('已回到房间全景。');
          if (options && options.focus && destinations[0]) {
            destinations[0].focus({ preventScroll: true });
          }
        };

        if (reduceMotion.matches || wasOverview) finish();
        else transitionTimer = window.setTimeout(finish, transitionDuration);
      }

      destinations.forEach(function(link){
        var preview = function(){
          if (stage.dataset.roomView === 'overview') {
            stage.dataset.roomPreview = link.getAttribute('data-room-destination');
          }
        };
        var clearPreview = function(){
          if (stage.dataset.roomPreview === link.getAttribute('data-room-destination')) {
            stage.removeAttribute('data-room-preview');
          }
        };

        link.addEventListener('pointerenter', preview);
        link.addEventListener('pointerleave', clearPreview);
        link.addEventListener('focus', preview);
        link.addEventListener('blur', clearPreview);
        link.addEventListener('click', function(event){
          if (
            event.defaultPrevented ||
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey
          ) return;

          event.preventDefault();
          var shouldFocusPanel = event.detail === 0;
          if (!shouldFocusPanel && document.activeElement === link) link.blur();
          moveTo(link.getAttribute('data-room-destination'), { focus: shouldFocusPanel });
        });
      });

      if (reset) {
        reset.addEventListener('click', function(event){
          event.preventDefault();
          showOverview({ focus: true });
        });
      }

      window.addEventListener('keydown', function(event){
        if (event.key === 'Escape' && stage.dataset.roomView !== 'overview') {
          showOverview({ focus: true });
        }
      });

      window.addEventListener('popstate', function(){
        var view = viewByHash[window.location.hash];
        if (view) moveTo(view, { history: false, focus: false, force: true });
        else showOverview({ history: false });
      });

      var initialView = viewByHash[window.location.hash];
      if (initialView) {
        setPanelAccess(initialView);
        stage.dataset.roomView = initialView;
        document.body.dataset.roomView = initialView;
      } else {
        setPanelAccess('overview');
        document.body.dataset.roomView = 'overview';
      }
      stage.dataset.roomMoving = 'false';
      stage.removeAttribute('aria-busy');
    })();
  </script>
</BaseLayout>
