---
import BaseLayout from '../layouts/BaseLayout.astro';
import InfoCard from '../components/InfoCard.astro';
---

<BaseLayout
  title="Qiu 的小屋 · 个人主页"
  description="Qiu 的小屋 · 个人主页，记录读到的、想到的和一些不想忘掉的东西。"
  ogTitle="Qiu 的小屋 · 个人主页"
  ogDescription="欢迎来到我的小角落。这里收着我读到的、想到的、和那些一时半会说不清楚但又不想忘掉的东西。"
  ogUrl="https://qianqiulp.github.io/"
  ogImage="/assets/og/site.svg"
  ogImageAlt="Qiu 的小屋个人主页封面图"
  bodyClass="page-home"
>

  <main class="container">

    <!-- 头部 -->
    <header class="header">
      <span class="header-icon">🪶</span>
      <h1>Qiu 的小屋</h1>
    </header>

    <!-- 引言框 -->
    <div class="callout">
      <span class="callout-icon">🪶</span>
      <p class="callout-content">欢迎来到我的小角落。这里收着我读到的、想到的、和那些一时半会说不清楚但又不想忘掉的东西。</p>
    </div>

    <!-- 关于这里 -->
    <section>
      <h2 class="section-title">关于这里</h2>
      <div class="cards-row">
        <InfoCard color="yellow" title="📅 不定期更新" description="写完才发，不追时间表。" />
        <InfoCard color="green" title="🍵 慢读优先" description="写给愿意慢下来读完的人。" />
        <InfoCard color="purple" title="🎲 主题随心" description="游戏、阅读、思考、生活。" />
      </div>
    </section>

    <!-- 最新文章 -->
    <section class="section-spaced">
      <h2 class="section-title">📚 最新文章</h2>
      <p class="section-subtitle">偶尔上新 · 慢慢长长</p>
      <div class="mb-10">
        <a href="/blog/" class="blog-entrance-button">
          <span>🪶 进入小屋文章 · 慢读优先</span>
          <span class="arrow">→</span>
        </a>
      </div>
    </section>

    <!-- 探索与作品 -->
    <section class="section-spaced">
      <h2 class="section-title">🚀 探索与联系</h2>
      <div class="cards-row cards-row-wide">

        <div class="card card-shadow-sm">
          <h2 class="card-heading">📋 关于我</h2>
          <p class="card-description">
            我是千秋（也可以直接叫我 Qiu 或秋）。现在是大二的计算机学生，喜欢二次元、电吉他和前沿技术。这里是我的小角落，欢迎来逛。
          </p>
        </div>

        <div class="card card-shadow-sm card-flex">
          <div>
            <h2 class="card-heading">🛠️ 我的作品</h2>
            <p class="card-description-mb">
              查看我做过的、正在做的和计划中的项目展示。
            </p>
          </div>
          <a href="/projects/" class="cta-button cta-button-sm">看看作品 →</a>
        </div>

      </div>

      <!-- 联系方式卡片 -->
      <div class="card card-shadow-sm card-contact">
        <h2 class="card-heading">📬 联系我</h2>
        <ul class="contact-list">
          <li class="contact-list-item">
            Bilibili：<a href="https://space.bilibili.com/400485069?spm_id_from=333.33.0.0" target="_blank" rel="noopener" class="contact-list-link">space.bilibili.com/400485069</a>
          </li>
          <li class="contact-list-item">
            GitHub：<a href="https://github.com/qianqiulp" target="_blank" rel="noopener" class="contact-list-link">github.com/qianqiulp</a>
          </li>
        </ul>
      </div>
    </section>

  </main>

</BaseLayout>

<style>
  .container {
    max-width: 640px;
    margin: 0 auto;
    padding: 80px 24px 40px;
    flex: 1;
  }

  .header {
    text-align: center;
    margin-bottom: 56px;
  }

  .header h1 {
    margin: 0 0 12px;
    font-size: 2.4rem;
    font-weight: 700;
    letter-spacing: 2px;
  }

  .card {
    padding: 28px 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-elevated);
    box-shadow: var(--shadow-md);
    transition: transform 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
  }

  .card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .card h2 {
    margin-bottom: 10px;
    color: var(--accent);
    font-size: 1.15rem;
    font-weight: 600;
  }

  .card p {
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .cta-card {
    text-align: center;
  }

  .cta-card h2 {
    margin-bottom: 14px;
  }

  .cta-card p {
    margin-bottom: 0;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 18px;
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 0.02em;
    box-shadow: 0 8px 18px rgba(9, 132, 227, 0.22);
    transition: transform 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out), filter 0.2s var(--ease-out);
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 22px rgba(9, 132, 227, 0.28);
    filter: brightness(1.03);
  }

  .cta-button:focus-visible {
    outline: 3px solid rgba(9, 132, 227, 0.28);
    outline-offset: 3px;
  }

  .contact-list {
    display: flex;
    gap: var(--space-5);
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-list li {
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .contact-list a {
    color: var(--accent);
    text-decoration: none;
  }

  .contact-list a:hover {
    text-decoration: underline;
  }

  /* Colored cards styling moved to InfoCard.astro component */

  @media (max-width: 480px) {
    .container {
      padding: 60px 16px 32px;
    }

    .header h1 {
      font-size: 1.8rem;
    }

    .card {
      padding: 20px 16px;
    }
  }

  /* Qiu's Cabin Callout Style */
  .callout {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    background: var(--surface-callout);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    margin-bottom: var(--space-10);
    color: var(--text);
    line-height: 1.7;
  }

  .callout-icon {
    font-size: 1.35rem;
    line-height: 1;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .callout-content {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: 0;
  }

  /* About Section Header */
  .section-title {
    font-size: 1.3rem;
    font-weight: 700;
    margin: 0 0 var(--space-4);
    color: var(--text);
    letter-spacing: 0.5px;
  }

  /* Horizontal Cards Grid for 'About' */
  .cards-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  .cards-row .card {
    padding: var(--space-5) var(--space-4);
    margin-bottom: 0;
  }

  .cards-row .card h2 {
    font-size: 1.05rem;
    margin-top: 0;
    margin-bottom: var(--space-2);
  }

  .cards-row .card p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  /* Recent Articles & Navigation styling adjustments */
  .section-subtitle {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-top: calc(var(--space-2) * -1);
    margin-bottom: var(--space-4);
  }

  /* Blog Entrance Button Style */
  .blog-entrance-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 16px 24px;
    border-radius: var(--radius-md);
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
    font-size: 1.05rem;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s var(--ease-out), border-color 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out), background-color 0.2s var(--ease-out);
    cursor: pointer;
  }

  .blog-entrance-button:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
    background: var(--surface-muted);
    text-decoration: none;
  }

  .blog-entrance-button .arrow {
    display: inline-block;
    transition: transform 0.2s;
  }

  .blog-entrance-button:hover .arrow {
    transform: translateX(4px);
  }

  /* Utility classes & component variants */
  .header-icon {
    font-size: 3.5rem;
    display: block;
    margin-bottom: var(--space-2);
    line-height: 1;
  }

  .section-spaced {
    margin-top: var(--space-6);
  }

  .mb-10 { margin-bottom: var(--space-10); }

  .cards-row-wide {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
  }

  .card-shadow-sm { box-shadow: var(--shadow-sm); }

  .card-flex {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .card-heading {
    font-size: 1.1rem;
    color: var(--accent);
    margin-top: 0;
    margin-bottom: var(--space-2);
  }

  .card-description {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin: 0;
  }

  .card-description-mb {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin: 0 0 var(--space-4);
  }

  .cta-button-sm {
    padding: 10px 16px;
    font-size: 0.9rem;
    align-self: flex-start;
    text-decoration: none;
  }

  .card-contact {
    margin-top: var(--space-4);
    margin-bottom: var(--space-10);
  }

  .contact-list-item {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .contact-list-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
  }
</style>
