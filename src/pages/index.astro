---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { featuredProjects } from '../data/projects';
import { featuredProjectsEn } from '../data/projects.en';
import { localizedPath, type Lang } from '../i18n';
import roomOverviewDay from '../assets/home/practice-room-overview-day.png';
import roomOverviewNight from '../assets/home/practice-room-overview-night.png';
import roomWritingDay from '../assets/home/practice-room-writing-day.png';
import roomWritingNight from '../assets/home/practice-room-writing-night.png';
import roomProjectsDay from '../assets/home/practice-room-projects-day.png';
import roomProjectsNight from '../assets/home/practice-room-projects-night.png';
import roomCurtain from '../assets/home/practice-room-curtain-4k.webp';
import qiuRelicGuitar from '../assets/home/qiu-relic-guitar-4k.webp';
import '../styles/home-room.css';

const lang: Lang = Astro.props.lang === 'en' ? 'en' : 'zh';
const isEnglish = lang === 'en';
const path = (value: string) => localizedPath(value, lang);
const copy = isEnglish ? {
  title: "Qianqiu's Home · Qiu's Room",
  description: "Step into Qianqiu's room and meet his building, writing, and life through the desk, workbench, and guitar.",
  ogDescription: 'Get to know Qianqiu slowly, through the things in this room.',
  ogImageAlt: "Cover image for Qianqiu's home",
  writingTitle: 'Recent writing', allPosts: 'All articles',
  projectsTitle: 'Engineering archive', allProjects: 'Full projects page',
  file: 'File', openFile: 'Open dossier',
  introTitle: "I'm Qianqiu.", intro: 'Guitar, games, relationships, and many thoughts still unfinished.',
  destinationsAria: 'Get to know Qianqiu through the room',
  desk: 'Desk', writing: 'Writing', deskAria: 'Approach the desk and view articles',
  workbench: 'Workbench', projects: 'Projects', workbenchAria: 'Approach the workbench and view projects',
  guitar: 'Guitar', life: 'Life', guitarAria: 'Approach the guitar and view notes from life',
  lifeTitle: 'This room also keeps the parts that never became projects.',
  lifeBody: 'Guitar practice, games, relationships, and ordinary experience shape how I think. I write down what I can share and leave what remains unresolved as questions.',
  lifeWriting: 'Writing shaped by life', lifePostsAria: 'Articles drawn from lived experience', linksAria: 'Other public links',
  reset: 'Back to the room', hint: 'There is more beyond the light.',
  moving: 'The view is moving toward ', object: 'something in the room', arrived: 'The view has reached ', target: 'the destination',
  returning: 'The view is returning to the whole room.', returned: 'Back in the whole room.',
} : {
  title: '千秋的个人主页 · Qiu 的小屋',
  description: '走进千秋的个人房间，从书桌、工作台与吉他认识他的构建、写作和生活。',
  ogDescription: '从房间里的东西，慢慢认识千秋。',
  ogImageAlt: '千秋的个人主页封面图',
  writingTitle: '最近的文字', allPosts: '全部文章',
  projectsTitle: '工程档案', allProjects: '完整作品页',
  file: '档', openFile: '展开卷宗',
  introTitle: '我是千秋。', intro: '练琴，游戏，关系，还有许多没想完的事。',
  destinationsAria: '从房间里认识千秋',
  desk: '书桌', writing: '文章', deskAria: '走近书桌，查看文章',
  workbench: '工作台', projects: '作品', workbenchAria: '走近工作台，查看作品',
  guitar: '吉他', life: '生活', guitarAria: '走近吉他，查看生活侧记',
  lifeTitle: '这里也收着没有被做成作品的部分。',
  lifeBody: '练琴、游戏、关系和日常经验会进入我的判断。我把能公开的部分写下来，也把还没想清楚的地方保留成问题。',
  lifeWriting: '生活留下的文字', lifePostsAria: '来自生活经验的文章', linksAria: '其他公开入口',
  reset: '回到房间', hint: '光外还有东西。',
  moving: '视线正在走向', object: '房间里的物件', arrived: '已经走到', target: '目标',
  returning: '视线正在回到房间全景。', returned: '已回到房间全景。',
};

const posts = isEnglish
  ? await getCollection('postsEn')
  : await getCollection('posts');
const latestPosts = posts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const postsById = new Map(posts.map((post) => [post.id, post]));
const lifePostIds = [
  '2026-05-29-liar-game-role-game',
  '2026-05-17-qiyuniao',
];
const lifePosts = lifePostIds.map((postId) => {
  const post = postsById.get(postId);
  if (!post) {
    throw new Error(`Homepage life post missing from posts collection: ${postId}`);
  }
  return post;
});
const roomProjectsList = (isEnglish ? featuredProjectsEn : featuredProjects).slice(0, 3);

const dateFormatter = new Intl.DateTimeFormat(isEnglish ? 'en-US' : 'zh-CN', {
  month: '2-digit',
  day: '2-digit',
});
const formatDate = (date: Date) => date.toISOString().slice(0, 10);
---

<BaseLayout
  lang={lang}
  title={copy.title}
  description={copy.description}
  ogTitle={copy.title}
  ogDescription={copy.ogDescription}
  ogUrl={`https://qianqiulp.github.io${path('/')}`}
  ogImage="/assets/og/site.svg"
  ogImageAlt={copy.ogImageAlt}
  bodyClass="page-home page-home--room"
  themeColorLight="#08090a"
  themeColorDark="#08090a"
>
  <main
    class="room-home"
    id="main-content"
    tabindex="-1"
    data-room-stage
    data-room-view="overview"
    data-room-discovery="person"
    data-room-moving="false"
  >
    <div class="room-camera">
      <div class="room-canvas">
        <div class="room-world" aria-hidden="true">
          <Image
            class="room-scene room-scene--overview room-theme-image room-theme-image--night"
            src={roomOverviewNight}
            alt=""
            loading="eager"
            fetchpriority="high"
            widths={[960, 1280, 1672]}
            sizes="max(100vw, 177.78vh)"
            quality={88}
          />
          <Image
            class="room-scene room-scene--overview room-theme-image room-theme-image--day"
            src={roomOverviewDay}
            alt=""
            loading="eager"
            fetchpriority="high"
            widths={[960, 1280, 1672]}
            sizes="max(100vw, 177.78vh)"
            quality={88}
          />
        </div>

        <Image
          class="room-curtain"
          src={roomCurtain}
          alt=""
          loading="eager"
          fetchpriority="low"
          widths={[1280, 1920, 2560, 3840]}
          sizes="max(100vw, 177.78vh)"
          quality={84}
          aria-hidden="true"
        />

        <div class="room-guitar-wrap" aria-hidden="true">
          <span class="room-guitar-shadow"></span>
          <Image
            class="room-guitar"
            src={qiuRelicGuitar}
            alt=""
            loading="eager"
            widths={[640, 960, 1440, 2160]}
            sizes="(max-width: 640px) 116vw, 44vw"
            quality={90}
          />
        </div>

        <section
          class="room-focus-layer room-focus-layer--writing"
          id="writing-desk"
          data-room-panel="writing"
          aria-labelledby="writing-desk-title"
        >
          <Image
            class="room-focus-plate room-theme-image room-theme-image--night"
            src={roomWritingNight}
            alt=""
            loading="lazy"
            fetchpriority="low"
            widths={[960, 1280, 1672]}
            sizes="max(100vw, 177.78vh)"
            quality={88}
            aria-hidden="true"
          />
          <Image
            class="room-focus-plate room-theme-image room-theme-image--day"
            src={roomWritingDay}
            alt=""
            loading="lazy"
            fetchpriority="low"
            widths={[960, 1280, 1672]}
            sizes="max(100vw, 177.78vh)"
            quality={88}
            aria-hidden="true"
          />

          <div class="room-monitor-surface" tabindex="-1">
            <header class="room-surface-heading">
              <h2 id="writing-desk-title">{copy.writingTitle}</h2>
              <a href={path('/blog/')}>{copy.allPosts}</a>
            </header>
            <ol class="room-writing-list">
              {latestPosts.map((post, index) => (
                <li>
                  <a
                    href={path(`/blog/posts/${post.id}/`)}
                    data-room-autofocus={index === 0 ? '' : undefined}
                  >
                    <time datetime={formatDate(post.data.date)}>{dateFormatter.format(post.data.date)}</time>
                    <span>{post.data.title}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </section>

        <section
          class="room-focus-layer room-focus-layer--projects"
          id="project-workbench"
          data-room-panel="projects"
          aria-labelledby="project-workbench-title"
        >
          <Image
            class="room-focus-plate room-theme-image room-theme-image--night"
            src={roomProjectsNight}
            alt=""
            loading="lazy"
            fetchpriority="low"
            widths={[960, 1280, 1672]}
            sizes="max(100vw, 177.78vh)"
            quality={88}
            aria-hidden="true"
          />
          <Image
            class="room-focus-plate room-theme-image room-theme-image--day"
            src={roomProjectsDay}
            alt=""
            loading="lazy"
            fetchpriority="low"
            widths={[960, 1280, 1672]}
            sizes="max(100vw, 177.78vh)"
            quality={88}
            aria-hidden="true"
          />

          <div class="room-workbench-surface" tabindex="-1">
            <header class="room-surface-heading">
              <h2 id="project-workbench-title">{copy.projectsTitle}</h2>
              <a href={path('/projects/')}>{copy.allProjects}</a>
            </header>
            <ol class="room-project-list">
              {roomProjectsList.map((project, index) => (
                <li>
                  <a
                    href={`${path('/projects/')}#project-${index + 1}`}
                    data-room-autofocus={index === 0 ? '' : undefined}
                  >
                    <span class="room-project-list__folio">
                      <span aria-hidden="true">{copy.file}</span>
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <span class="room-project-list__type">{project.type}</span>
                    <strong>{project.displayName}</strong>
                    <small>{project.status}</small>
                    <span class="room-project-list__cue" aria-hidden="true">{copy.openFile}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </section>

        <div class="room-atmosphere" aria-hidden="true"></div>

        <div class="room-petals" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>

        <div class="room-discovery-veil" aria-hidden="true">
          <span class="room-discovery-shadow room-discovery-shadow--writing"></span>
          <span class="room-discovery-shadow room-discovery-shadow--projects"></span>
        </div>
      </div>
    </div>

    <section class="room-intro" aria-labelledby="home-title">
      <h1 id="home-title">{copy.introTitle}</h1>
      <p>{copy.intro}</p>
    </section>

    <nav class="room-destinations" aria-label={copy.destinationsAria}>
      <a
        class="room-hotspot room-hotspot--writing"
        href="#writing-desk"
        data-room-destination="writing"
        data-room-name={copy.desk}
        aria-label={copy.deskAria}
      >
        <span aria-hidden="true"><small>{copy.desk}</small>{copy.writing}</span>
      </a>
      <a
        class="room-hotspot room-hotspot--projects"
        href="#project-workbench"
        data-room-destination="projects"
        data-room-name={copy.workbench}
        aria-label={copy.workbenchAria}
      >
        <span aria-hidden="true"><small>{copy.workbench}</small>{copy.projects}</span>
      </a>
      <a
        class="room-hotspot room-hotspot--life"
        href="#life-corner"
        data-room-destination="life"
        data-room-name={copy.guitar}
        aria-label={copy.guitarAria}
      >
        <span aria-hidden="true"><small>{copy.guitar}</small>{copy.life}</span>
      </a>
    </nav>

    <aside
      class="room-life-note"
      id="life-corner"
      data-room-panel="life"
      aria-labelledby="life-note-title"
      tabindex="-1"
    >
      <h2 id="life-note-title">{copy.lifeTitle}</h2>
      <p>{copy.lifeBody}</p>
      <div class="room-life-note__evidence">
        <span>{copy.lifeWriting}</span>
        <ul class="room-life-note__traces" aria-label={copy.lifePostsAria}>
          {lifePosts.map((post, index) => (
            <li>
              <a
                href={path(`/blog/posts/${post.id}/`)}
                data-room-autofocus={index === 0 ? '' : undefined}
              >{post.data.title}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="room-life-note__links" aria-label={copy.linksAria}>
        <a href="https://github.com/qianqiulp" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a
          href="https://space.bilibili.com/400485069?spm_id_from=333.33.0.0"
          target="_blank"
          rel="noopener noreferrer"
        >Bilibili</a>
      </div>
    </aside>

    <a class="room-reset" href={path('/')} data-room-reset>{copy.reset}</a>
    <p class="room-hint" aria-hidden="true">{copy.hint}</p>
    <div class="room-camera-progress" aria-hidden="true"><span></span></div>
    <p class="room-sr-only" aria-live="polite" data-room-status></p>
  </main>

  <script is:inline define:vars={{ roomCopy: {
    moving: copy.moving, object: copy.object, arrived: copy.arrived, target: copy.target,
    returning: copy.returning, returned: copy.returned,
  } }}>
    (function(){
      var stage = document.querySelector('[data-room-stage]');
      if (!stage) return;

      var destinations = Array.prototype.slice.call(
        stage.querySelectorAll('[data-room-destination]')
      );
      var panels = Array.prototype.slice.call(stage.querySelectorAll('[data-room-panel]'));
      var destinationNav = stage.querySelector('.room-destinations');
      var reset = stage.querySelector('[data-room-reset]');
      var status = stage.querySelector('[data-room-status]');
      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      var transitionTimer = 0;
      var transitionDuration = 2400;
      var hashByView = {
        writing: '#writing-desk',
        projects: '#project-workbench',
        life: '#life-corner'
      };
      var viewByHash = {
        '#writing-desk': 'writing',
        '#project-workbench': 'projects',
        '#life-corner': 'life'
      };
      var discoverableViews = ['writing', 'projects'];
      var discoveredViews = new Set();
      var discoveryStorageKey = 'room-stage-lit-v2';

      function restoreDiscovery() {
        try {
          var storedViews = JSON.parse(sessionStorage.getItem(discoveryStorageKey) || '[]');
          if (Array.isArray(storedViews)) {
            storedViews.forEach(function(view){
              if (discoverableViews.indexOf(view) !== -1) discoveredViews.add(view);
            });
          }
          /* 舞台分区已改变；清理旧版三块/单块记忆，避免右侧错误恢复为全亮。 */
          sessionStorage.removeItem('room-lit');
          sessionStorage.removeItem('room-memory');
        } catch (error) {}
      }

      function renderDiscovery() {
        discoverableViews.forEach(function(view){
          stage.toggleAttribute('data-room-lit-' + view, discoveredViews.has(view));
        });
        stage.dataset.roomDiscovery = discoveredViews.size ? 'room' : 'person';
        try {
          sessionStorage.setItem(discoveryStorageKey, JSON.stringify(Array.from(discoveredViews)));
        } catch (error) {}
      }

      function rememberView(view) {
        if (discoverableViews.indexOf(view) === -1) return;
        discoveredViews.add(view);
        renderDiscovery();
      }

      function announce(message) {
        if (status) status.textContent = message;
      }

      function setPanelAccess(view) {
        if (destinationNav) {
          destinationNav.toggleAttribute('inert', view !== 'overview');
        }
        panels.forEach(function(panel){
          var isActive = panel.getAttribute('data-room-panel') === view;
          panel.toggleAttribute('inert', !isActive);
          panel.setAttribute('aria-hidden', isActive ? 'false' : 'true');
        });
      }

      function settle(view, shouldFocus) {
        stage.dataset.roomMoving = 'false';
        document.body.dataset.roomView = view;
        stage.removeAttribute('aria-busy');

        if (!shouldFocus) return;
        var panel = stage.querySelector('[data-room-panel="' + view + '"]');
        var focusTarget = panel && panel.querySelector('[data-room-autofocus]');
        if (focusTarget) focusTarget.focus({ preventScroll: true });
        else if (panel) panel.focus({ preventScroll: true });
      }

      function moveTo(view, options) {
        if (!hashByView[view]) return;
        if (stage.dataset.roomMoving === 'true' && !(options && options.force)) return;
        if (stage.dataset.roomView === view && !(options && options.force)) return;

        window.clearTimeout(transitionTimer);
        stage.removeAttribute('data-room-preview');
        rememberView(view);
        setPanelAccess(view);
        stage.dataset.roomMoving = reduceMotion.matches ? 'false' : 'true';
        stage.dataset.roomView = view;
        document.body.dataset.roomView = view;
        stage.setAttribute('aria-busy', 'true');

        if (!options || options.history !== false) {
          history.pushState({ roomView: view }, '', hashByView[view]);
        }

        var destination = destinations.find(function(link){
          return link.getAttribute('data-room-destination') === view;
        });
        var name = destination && destination.getAttribute('data-room-name');
        announce(roomCopy.moving + (name || roomCopy.object) + '.');

        if (reduceMotion.matches) {
          settle(view, !options || options.focus !== false);
          return;
        }

        transitionTimer = window.setTimeout(function(){
          announce(roomCopy.arrived + (name || roomCopy.target) + '.');
          settle(view, !options || options.focus !== false);
        }, transitionDuration);
      }

      function showOverview(options) {
        window.clearTimeout(transitionTimer);
        stage.removeAttribute('data-room-preview');
        var wasOverview = stage.dataset.roomView === 'overview';
        var returnView = stage.dataset.roomView;
        stage.dataset.roomMoving = reduceMotion.matches || wasOverview ? 'false' : 'true';
        stage.dataset.roomView = 'overview';
        renderDiscovery();
        document.body.dataset.roomView = 'overview';
        stage.setAttribute('aria-busy', 'true');

        if (!options || options.history !== false) {
          history.replaceState({ roomView: 'overview' }, '', window.location.pathname + window.location.search);
        }

        announce(roomCopy.returning);

        var finish = function(){
          setPanelAccess('overview');
          stage.dataset.roomMoving = 'false';
          stage.removeAttribute('aria-busy');
          announce(roomCopy.returned);
          if (options && options.focus) {
            var returnDestination = destinations.find(function(link){
              return link.getAttribute('data-room-destination') === returnView;
            });
            if (returnDestination) returnDestination.focus({ preventScroll: true });
          }
        };

        if (reduceMotion.matches || wasOverview) finish();
        else transitionTimer = window.setTimeout(finish, transitionDuration);
      }

      destinations.forEach(function(link){
        var preview = function(){
          if (stage.dataset.roomView === 'overview') {
            stage.dataset.roomPreview = link.getAttribute('data-room-destination');
          }
        };
        var clearPreview = function(){
          if (stage.dataset.roomPreview === link.getAttribute('data-room-destination')) {
            stage.removeAttribute('data-room-preview');
          }
        };

        link.addEventListener('pointerenter', preview);
        link.addEventListener('pointerleave', clearPreview);
        link.addEventListener('focus', preview);
        link.addEventListener('blur', clearPreview);
        link.addEventListener('click', function(event){
          if (
            event.defaultPrevented ||
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey
          ) return;

          event.preventDefault();
          var shouldFocusPanel = event.detail === 0;
          if (!shouldFocusPanel && document.activeElement === link) link.blur();
          moveTo(link.getAttribute('data-room-destination'), { focus: shouldFocusPanel });
        });
      });

      if (reset) {
        reset.addEventListener('click', function(event){
          event.preventDefault();
          showOverview({ focus: true });
        });
      }

      window.addEventListener('keydown', function(event){
        if (event.key === 'Escape' && stage.dataset.roomView !== 'overview') {
          showOverview({ focus: true });
        }
      });

      window.addEventListener('popstate', function(){
        var view = viewByHash[window.location.hash];
        if (view) moveTo(view, { history: false, focus: false, force: true });
        else showOverview({ history: false });
      });

      restoreDiscovery();
      var initialView = viewByHash[window.location.hash];
      if (initialView) {
        rememberView(initialView);
        setPanelAccess(initialView);
        stage.dataset.roomView = initialView;
        document.body.dataset.roomView = initialView;
      } else {
        renderDiscovery();
        setPanelAccess('overview');
        document.body.dataset.roomView = 'overview';
      }
      stage.dataset.roomMoving = 'false';
      stage.removeAttribute('aria-busy');
    })();
  </script>
</BaseLayout>
