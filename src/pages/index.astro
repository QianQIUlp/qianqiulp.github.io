---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Qiu 的小屋 · 个人主页"
  description="Qiu 的小屋 · 个人主页，记录读到的、想到的和一些不想忘掉的东西。"
  ogTitle="Qiu 的小屋 · 个人主页"
  ogDescription="欢迎来到我的小角落。这里收着我读到的、想到的、和那些一时半会说不清楚但又不想忘掉的东西。"
  ogUrl="https://qianqiulp.github.io/"
  ogImage="/assets/og/site.svg"
  ogImageAlt="Qiu 的小屋个人主页封面图"
  bodyClass="page-home"
>

  <main class="container">

    <!-- 头部 -->
    <header class="header">
      <span class="header-icon">🪶</span>
      <h1>Qiu 的小屋</h1>
    </header>

    <!-- 引言框 -->
    <div class="callout">
      <span class="callout-icon">🪶</span>
      <p class="callout-content">欢迎来到我的小角落。这里收着我读到的、想到的、和那些一时半会说不清楚但又不想忘掉的东西。</p>
    </div>

    <!-- 关于这里 -->
    <section>
      <h2 class="section-title">关于这里</h2>
      <div class="cards-row">
        <div class="card card-yellow">
          <h2>📅 不定期更新</h2>
          <p>写完才发，不追时间表。</p>
        </div>
        <div class="card card-green">
          <h2>🍵 慢读优先</h2>
          <p>写给愿意慢下来读完的人。</p>
        </div>
        <div class="card card-purple">
          <h2>🎲 主题随心</h2>
          <p>游戏、阅读、思考、生活。</p>
        </div>
      </div>
    </section>

    <!-- 最新文章 -->
    <section class="section-spaced">
      <h2 class="section-title">📚 最新文章</h2>
      <p class="section-subtitle">偶尔上新 · 慢慢长长</p>
      <div class="mb-10">
        <a href="/blog/" class="blog-entrance-button">
          <span>🪶 进入小屋文章 · 慢读优先</span>
          <span class="arrow">→</span>
        </a>
      </div>
    </section>

    <!-- 探索与作品 -->
    <section class="section-spaced">
      <h2 class="section-title">🚀 探索与联系</h2>
      <div class="cards-row cards-row-wide">

        <div class="card card-shadow-sm">
          <h2 class="card-heading">📋 关于我</h2>
          <p class="card-description">
            我是千秋（也可以直接叫我 Qiu 或秋）。现在是大二的计算机学生，喜欢二次元、电吉他和前沿技术。这里是我的小角落，欢迎来逛。
          </p>
        </div>

        <div class="card card-shadow-sm card-flex">
          <div>
            <h2 class="card-heading">🛠️ 我的作品</h2>
            <p class="card-description-mb">
              查看我做过的、正在做的和计划中的项目展示。
            </p>
          </div>
          <a href="/projects/" class="cta-button cta-button-sm">看看作品 →</a>
        </div>

      </div>

      <!-- 联系方式卡片 -->
      <div class="card card-shadow-sm card-contact">
        <h2 class="card-heading">📬 联系我</h2>
        <ul class="contact-list">
          <li class="contact-list-item">
            Bilibili：<a href="https://space.bilibili.com/400485069?spm_id_from=333.33.0.0" target="_blank" rel="noopener" class="contact-list-link">space.bilibili.com/400485069</a>
          </li>
          <li class="contact-list-item">
            GitHub：<a href="https://github.com/qianqiulp" target="_blank" rel="noopener" class="contact-list-link">github.com/qianqiulp</a>
          </li>
        </ul>
      </div>
    </section>

  </main>

</BaseLayout>

<style>
  .container {
    max-width: 640px;
    margin: 0 auto;
    padding: 80px 24px 40px;
    flex: 1;
  }

  .header {
    text-align: center;
    margin-bottom: 56px;
  }

  .header h1 {
    margin: 0 0 12px;
    font-size: 2.4rem;
    font-weight: 700;
    letter-spacing: 2px;
  }

  .card {
    padding: 28px 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-elevated);
    box-shadow: var(--shadow-md);
    transition: transform 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
  }

  .card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .card h2 {
    margin-bottom: 10px;
    color: var(--accent);
    font-size: 1.15rem;
    font-weight: 600;
  }

  .card p {
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .cta-card {
    text-align: center;
  }

  .cta-card h2 {
    margin-bottom: 14px;
  }

  .cta-card p {
    margin-bottom: 0;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 18px;
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 0.02em;
    box-shadow: 0 8px 18px rgba(9, 132, 227, 0.22);
    transition: transform 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out), filter 0.2s var(--ease-out);
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 22px rgba(9, 132, 227, 0.28);
    filter: brightness(1.03);
  }

  .cta-button:focus-visible {
    outline: 3px solid rgba(9, 132, 227, 0.28);
    outline-offset: 3px;
  }

  .contact-list {
    display: flex;
    gap: var(--space-5);
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-list li {
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .contact-list a {
    color: var(--accent);
    text-decoration: none;
  }

  .contact-list a:hover {
    text-decoration: underline;
  }

  .card.card-yellow {
    background: var(--card-yellow-bg);
    border-color: var(--card-yellow-border);
    box-shadow: none;
  }
  .card.card-yellow h2,
  .card.card-yellow p {
    color: var(--card-yellow-text);
  }

  .card.card-green {
    background: var(--card-green-bg);
    border-color: var(--card-green-border);
    box-shadow: none;
  }
  .card.card-green h2,
  .card.card-green p {
    color: var(--card-green-text);
  }

  .card.card-purple {
    background: var(--card-purple-bg);
    border-color: var(--card-purple-border);
    box-shadow: none;
  }
  .card.card-purple h2,
  .card.card-purple p {
    color: var(--card-purple-text);
  }

  @media (max-width: 480px) {
    .container {
      padding: 60px 16px 32px;
    }

    .header h1 {
      font-size: 1.8rem;
    }

    .card {
      padding: 20px 16px;
    }
  }
</style>
