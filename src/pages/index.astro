---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('posts');
const latestPosts = posts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);
const featuredPost = latestPosts[0];
const secondaryPosts = latestPosts.slice(1);
const tagCount = new Set(posts.flatMap((post) => post.data.tags)).size;
const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
const formatDate = (date: Date) => date.toISOString().slice(0, 10);
const formatDisplayDate = (date: Date) => dateFormatter.format(date);
---

<BaseLayout
  title="Qiu 的小屋 · 个人主页"
  description="Qiu 的小屋 · 个人主页，记录读到的、想到的和一些不想忘掉的东西。"
  ogTitle="Qiu 的小屋 · 个人主页"
  ogDescription="欢迎来到我的小角落。这里收着我读到的、想到的、和那些一时半会说不清楚但又不想忘掉的东西。"
  ogUrl="https://qianqiulp.github.io/"
  ogImage="/assets/og/site.svg"
  ogImageAlt="Qiu 的小屋个人主页封面图"
  bodyClass="page-home"
>
  <main class="page-shell" id="main-content" tabindex="-1">
    <section class="study-entrance" aria-labelledby="home-title">
      <div class="study-intro">
        <p class="eyebrow">Study Room / Qiu 的小屋</p>
        <h1 class="hero-title" id="home-title">把读过、想过和折腾过的事，慢慢整理成可回看的<span class="no-break">文字</span>。</h1>
        <p class="hero-lead">
          我是千秋，也可以叫我 Qiu 或秋。这里主要放技术实践、阅读随笔、游戏观察和一些仍在成形的想法。
        </p>
        <dl class="study-shelf" aria-label="站点概览">
          <div>
            <dt>{posts.length}</dt>
            <dd>篇文章</dd>
          </div>
          <div>
            <dt>{tagCount}</dt>
            <dd>个主题</dd>
          </div>
          <div>
            <dt>2026</dt>
            <dd>开始整理</dd>
          </div>
        </dl>
        <div class="hero-actions">
          <a class="button" href="/blog/">读最新文章</a>
          <a class="button button--secondary" href="/projects/">看作品与探索</a>
        </div>
      </div>

      <aside class="desk-panel" aria-labelledby="desk-title">
        <div class="desk-panel__header">
          <p class="eyebrow">On the desk</p>
          <h2 id="desk-title">现在摊开的文章</h2>
          <p>首屏先放真实内容，让这间小屋从一篇正在阅读的文字开始。</p>
        </div>

        {featuredPost && (
          <a class="desk-feature" href={`/blog/posts/${featuredPost.id}/`}>
            <div class="desk-feature__media">
              {featuredPost.data.ogImage ? (
                <Image
                  src={featuredPost.data.ogImage}
                  alt={featuredPost.data.ogImageAlt || `《${featuredPost.data.title}》文章封面`}
                  loading="eager"
                />
              ) : (
                <div class="desk-feature__fallback" aria-hidden="true">Qiu</div>
              )}
            </div>
            <div class="desk-feature__body">
              <p class="meta-line">
                <time datetime={formatDate(featuredPost.data.date)}>{formatDisplayDate(featuredPost.data.date)}</time>
                <span>{featuredPost.data.tags.slice(0, 2).join(' / ')}</span>
              </p>
              <h3>{featuredPost.data.title}</h3>
              <p>{featuredPost.data.description}</p>
            </div>
          </a>
        )}

        <div class="desk-index" aria-label="最近文章索引">
          {secondaryPosts.map((post) => (
            <a href={`/blog/posts/${post.id}/`}>
              <time datetime={formatDate(post.data.date)}>{formatDisplayDate(post.data.date)}</time>
              <span>{post.data.title}</span>
            </a>
          ))}
        </div>
      </aside>
    </section>

    <section class="section-block reading-principles" aria-labelledby="about-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">About</p>
          <h2 id="about-title">关于这里</h2>
        </div>
        <p>更像一间安静的小书房：能放备忘录，也能放长一点的思考。</p>
      </div>
      <div class="principle-list">
        <article>
          <span>01</span>
          <h3>不定期更新</h3>
          <p>写完才发，不把个人站变成打卡压力。</p>
        </article>
        <article>
          <span>02</span>
          <h3>慢读优先</h3>
          <p>偏向完整上下文、可回看笔记和长期问题。</p>
        </article>
        <article>
          <span>03</span>
          <h3>主题开放</h3>
          <p>技术、AI、心理、游戏、学习路径都会出现。</p>
        </article>
      </div>
    </section>

    <section class="section-block home-index-section" aria-labelledby="latest-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Reading Index</p>
          <h2 id="latest-title">最近入档</h2>
        </div>
        <a class="surface-link" href="/blog/">全部文章</a>
      </div>

      <div class="home-ledger">
        {latestPosts.map((post) => (
          <a class="home-ledger__row" href={`/blog/posts/${post.id}/`}>
            <time datetime={formatDate(post.data.date)}>{formatDisplayDate(post.data.date)}</time>
            <div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </div>
            <span>{post.data.tags.slice(0, 2).join(' / ')}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section-block study-corners" aria-labelledby="explore-title">
      <div class="home-workbench">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Explore</p>
            <h2 id="explore-title">作品与探索</h2>
          </div>
        </div>
        <a class="workbench-preview" href="/projects/">
          <span>更新中</span>
          <h3>正在整理的项目与学习路径</h3>
          <p>收着一个真实工程项目 Docker-Hadoop-Cluster，也放着这个站点的写作基础和几篇可复用的公开指南。</p>
          <strong>进入作品页</strong>
        </a>
      </div>

      <aside class="contact-card" aria-labelledby="contact-title">
        <p class="eyebrow">Contact</p>
        <h2 id="contact-title">联系我</h2>
        <p>如果你想交流文章、项目或学习路线，可以从这些入口找到我。</p>
        <ul class="contact-list">
          <li>
            <a
              class="contact-link contact-link--github"
              href="https://github.com/qianqiulp"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="打开 GitHub 主页（新标签页）"
              title="打开 GitHub 主页"
            >
              <svg class="contact-link__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.09 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.14c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.75 1.18 1.75 1.18 1.02 1.75 2.67 1.24 3.33.95.1-.74.4-1.24.72-1.53-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18.91-.25 1.89-.38 2.86-.38s1.95.13 2.86.38c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.74.8 1.18 1.82 1.18 3.08 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.13v3.17c0 .31.21.67.79.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
              </svg>
              <span>GitHub</span>
            </a>
          </li>
          <li>
            <a
              class="contact-link contact-link--bilibili"
              href="https://space.bilibili.com/400485069?spm_id_from=333.33.0.0"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="打开 Bilibili 主页（新标签页）"
              title="打开 Bilibili 主页"
            >
              <svg class="contact-link__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M8.25 4.15 6.32 2.22 5.08 3.46l2.2 2.2H6.05A3.55 3.55 0 0 0 2.5 9.21v7.24A3.55 3.55 0 0 0 6.05 20h11.9a3.55 3.55 0 0 0 3.55-3.55V9.21a3.55 3.55 0 0 0-3.55-3.55h-1.23l2.2-2.2-1.24-1.24-1.93 1.93-1.51 1.51H9.76L8.25 4.15Zm-2.2 3.4h11.9c.92 0 1.66.74 1.66 1.66v7.24c0 .92-.74 1.66-1.66 1.66H6.05c-.92 0-1.66-.74-1.66-1.66V9.21c0-.92.74-1.66 1.66-1.66Z" />
                <path d="M8.25 11.1h1.9v3.35h-1.9V11.1Zm5.6 0h1.9v3.35h-1.9V11.1Z" />
              </svg>
              <span>Bilibili</span>
            </a>
          </li>
        </ul>
      </aside>
    </section>
  </main>
</BaseLayout>
