---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  featuredProjects,
  projectsPageCopy,
  secondaryProjects,
  selectedGuidePostIds,
} from '../../data/projects';

const posts = await getCollection('posts');
const postsById = new Map(posts.map((post) => [post.id, post]));
const missingGuidePostIds = selectedGuidePostIds.filter((postId) => !postsById.has(postId));

if (missingGuidePostIds.length > 0) {
  throw new Error(`Selected guide post IDs missing from posts collection: ${missingGuidePostIds.join(', ')}`);
}

const selectedGuidePosts = selectedGuidePostIds.map((postId) => {
  const post = postsById.get(postId);
  if (!post) {
    throw new Error(`Selected guide post ID missing from posts collection: ${postId}`);
  }
  return post;
});

const displayDate = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<BaseLayout
  title="作品与探索 · Qiu 的小屋"
  description="Qiu 的小屋 · 作品集，展示正在进行的探索、学习项目与未来计划。"
  ogTitle="作品与探索 · Qiu 的小屋"
  ogUrl="https://qianqiulp.github.io/projects/"
  ogImage="/assets/og/site.svg"
  ogImageAlt="Qiu 的小屋作品集封面图"
  bodyClass="page-projects"
>
  <main class="page-shell workbench-shell" id="main-content" tabindex="-1">
    <header class="page-hero workbench-hero">
      <div>
        <p class="eyebrow">Workbench Index</p>
        <h1 class="hero-title hero-title--compact">作品与探索</h1>
        <p class="hero-lead">{projectsPageCopy.heroLead}</p>
      </div>
      <p class="workbench-note">{projectsPageCopy.heroNote}</p>
    </header>

    <section class="featured-work" aria-labelledby="featured-work-title">
      <div class="section-heading">
        <p class="eyebrow">Featured Work</p>
        <h2 id="featured-work-title">真实项目</h2>
      </div>

      {featuredProjects.map((project) => (
        <article class="featured-work__card">
          <div class="featured-work__intro">
            <div>
              <p class="featured-work__meta">{project.status} · {project.type}</p>
              <h3>{project.displayName}</h3>
              <p class="featured-work__repo">{project.repoSlug}</p>
            </div>
            <div class="featured-work__links" aria-label={`${project.displayName} 链接`}>
              {project.links.map((link) => (
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                </a>
              ))}
            </div>
          </div>

          <div class="featured-work__brief">
            <p class="featured-work__summary">{project.summary}</p>
          </div>

          <div class="case-study">
            <section class="case-study__main" aria-label={`${project.displayName} 案例笔记`}>
              <p class="case-study__eyebrow">Case Study</p>
              <p><strong>问题：</strong>{project.caseStudy.problem}</p>
              <p><strong>设计：</strong>{project.caseStudy.design}</p>
              <ul class="case-study__points" aria-label={`${project.displayName} 实现抓手`}>
                {project.highlights.slice(0, 3).map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            </section>

            <aside class="case-study__side" aria-label={`${project.displayName} 开始与边界`}>
              <dl>
                <div>
                  <dt>开始</dt>
                  <dd>{project.caseStudy.start}</dd>
                </div>
                <div>
                  <dt>边界</dt>
                  <dd>{project.caseStudy.boundary}</dd>
                </div>
                <div>
                  <dt>下一步</dt>
                  <dd>{project.caseStudy.nextStep}</dd>
                </div>
              </dl>
            </aside>
          </div>

          <ul class="tag-list" aria-label={`${project.displayName} 技术标签`}>
            {project.tags.map((tag) => (
              <li><span class="tag-pill">{tag}</span></li>
            ))}
          </ul>
        </article>
      ))}
    </section>

    <section class="supporting-traces editorial-section" aria-labelledby="secondary-work-title">
      <header class="editorial-section__heading">
        <p class="eyebrow editorial-section__rail">{projectsPageCopy.infrastructure.eyebrow}</p>
        <div class="editorial-section__copy">
          <h2 id="secondary-work-title">{projectsPageCopy.infrastructure.title}</h2>
          <p>{projectsPageCopy.infrastructure.description}</p>
        </div>
      </header>
      <div class="editorial-section__body">
        <ul class="trace-list">
          {secondaryProjects.map((project) => (
            <li class="trace-item">
              <div class="trace-item__body">
                <p class="trace-item__meta">{project.status} · {project.tags.join(' / ')}</p>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
              </div>
              {project.href && (
                <a
                  class="trace-item__link"
                  href={project.href}
                  target={project.external ? '_blank' : undefined}
                  rel={project.external ? 'noopener noreferrer' : undefined}
                >
                  {project.linkLabel}
                </a>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="playbook-section editorial-section" aria-labelledby="playbook-title">
      <header class="editorial-section__heading">
        <p class="eyebrow editorial-section__rail">{projectsPageCopy.playbooks.eyebrow}</p>
        <div class="editorial-section__copy">
          <h2 id="playbook-title">{projectsPageCopy.playbooks.title}</h2>
          <p>{projectsPageCopy.playbooks.description}</p>
        </div>
      </header>
      <div class="editorial-section__body">
        <ol class="playbook-list">
          {selectedGuidePosts.map((post) => (
            <li class="playbook-item">
              <a class="playbook-item__link" href={`/blog/posts/${post.id}/`}>
                <span class="playbook-item__body">
                  <strong>{post.data.title}</strong>
                  <span>{post.data.description}</span>
                </span>
                <time datetime={post.data.date.toISOString().slice(0, 10)}>
                  {displayDate.format(post.data.date)}
                </time>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </main>
</BaseLayout>
