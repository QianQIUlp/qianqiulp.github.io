---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { featuredProjects, secondaryProjects } from '../../data/projects';
---

<BaseLayout
  title="作品与探索 · Qiu 的小屋"
  description="Qiu 的小屋 · 作品集，展示正在进行的探索、学习项目与未来计划。"
  ogTitle="作品与探索 · Qiu 的小屋"
  ogUrl="https://qianqiulp.github.io/projects/"
  ogImage="/assets/og/site.svg"
  ogImageAlt="Qiu 的小屋作品集封面图"
  bodyClass="page-projects"
>
  <main class="page-shell workbench-shell" id="main-content" tabindex="-1">
    <header class="page-hero workbench-hero">
      <div>
        <p class="eyebrow">Workbench Index</p>
        <h1 class="hero-title hero-title--compact">作品与探索</h1>
        <p class="hero-lead">这里先放一个真实可追踪的工程作品，再保留一些站点、学习和笔记线索作为附录。</p>
      </div>
      <p class="workbench-note">作品页不需要把项目包装成产品发布页，但要讲清楚它解决什么问题、怎么设计、别人可以从哪里开始看。</p>
    </header>

    <section class="featured-work" aria-labelledby="featured-work-title">
      <div class="section-heading">
        <p class="eyebrow">Featured Work</p>
        <h2 id="featured-work-title">真实项目</h2>
      </div>

      {featuredProjects.map((project) => (
        <article class="featured-work__card">
          <div class="featured-work__intro">
            <div>
              <p class="featured-work__meta">{project.status} · {project.type}</p>
              <h3>{project.displayName}</h3>
              <p class="featured-work__repo">{project.repoSlug}</p>
            </div>
            <div class="featured-work__links" aria-label={`${project.displayName} 链接`}>
              {project.links.map((link) => (
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                </a>
              ))}
            </div>
          </div>

          <div class="featured-work__brief">
            <p class="featured-work__summary">{project.summary}</p>
          </div>

          <div class="case-study">
            <section class="case-study__main" aria-label={`${project.displayName} 案例笔记`}>
              <p class="case-study__eyebrow">Case Study</p>
              <p><strong>问题：</strong>{project.caseStudy.problem}</p>
              <p><strong>设计：</strong>{project.caseStudy.design}</p>
              <ul class="case-study__points" aria-label={`${project.displayName} 实现抓手`}>
                {project.highlights.slice(0, 3).map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            </section>

            <aside class="case-study__side" aria-label={`${project.displayName} 开始与边界`}>
              <dl>
                <div>
                  <dt>开始</dt>
                  <dd>{project.caseStudy.start}</dd>
                </div>
                <div>
                  <dt>边界</dt>
                  <dd>{project.caseStudy.boundary}</dd>
                </div>
                <div>
                  <dt>下一步</dt>
                  <dd>{project.caseStudy.nextStep}</dd>
                </div>
              </dl>
            </aside>
          </div>

          <ul class="tag-list" aria-label={`${project.displayName} 技术标签`}>
            {project.tags.map((tag) => (
              <li><span class="tag-pill">{tag}</span></li>
            ))}
          </ul>
        </article>
      ))}
    </section>

    <section class="supporting-traces" aria-labelledby="secondary-work-title">
      <div class="section-heading supporting-traces__heading">
        <p class="eyebrow">Supporting Traces</p>
        <h2 id="secondary-work-title">站点与学习线索</h2>
        <p>这些是站点基础、学习轨迹和之后可能补上的线索，不作为独立作品展示。</p>
      </div>
      <ul class="trace-list">
        {secondaryProjects.map((project) => (
          <li class="trace-item">
            <p class="trace-item__meta">{project.status} · {project.tags.join(' / ')}</p>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            {project.href && (
              <a
                class="trace-item__link"
                href={project.href}
                target={project.external ? '_blank' : undefined}
                rel={project.external ? 'noopener noreferrer' : undefined}
              >
                {project.linkLabel}
              </a>
            )}
          </li>
        ))}
      </ul>
    </section>
  </main>
</BaseLayout>
